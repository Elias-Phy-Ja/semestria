<Window x:Class="SchulnetzSync.UI.Onboarding.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:legal="clr-namespace:SchulnetzSync.UI.Legal"
        xmlns:local="clr-namespace:SchulnetzSync.UI"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Semestria einrichten"
        Width="940" Height="700"
        MinWidth="860" MinHeight="600"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- Half-transparent grey works in both the light and the dark theme -->
        <SolidColorBrush x:Key="HoverOverlay"   Color="#1A808080"/>
        <SolidColorBrush x:Key="PressedOverlay" Color="#2A808080"/>
        <SolidColorBrush x:Key="SubtleFill"     Color="#12808080"/>
        <SolidColorBrush x:Key="SubtleBorder"   Color="#26808080"/>
        <SolidColorBrush x:Key="AccentTint"     Color="#265C6EF7"/>

        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="StepLead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="21"/>
            <Setter Property="Margin" Value="0,8,0,24"/>
        </Style>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,16"/>
        </Style>

        <!-- Round icon box with an accent tint -->
        <Style x:Key="IconTile" TargetType="Border">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{StaticResource AccentTint}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="IconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Step number in the walkthrough -->
        <Style x:Key="NumberBadge" TargetType="Border">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>

        <Style x:Key="AccentAction" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10"/>
                            <Border x:Name="Overlay" Background="Transparent" CornerRadius="10"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="#1FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="#26000000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineAction" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource SubtleBorder}" BorderThickness="1"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverOverlay}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedOverlay}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkAction" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverOverlay}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The big choice cards: Outlook now, or later -->
        <Style x:Key="ChoiceCard" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorder}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5"/>
                            <Border x:Name="Overlay" Background="Transparent" CornerRadius="12"/>
                            <ContentPresenter Margin="18,16"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Overlay" Property="Background" Value="{StaticResource SubtleFill}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="{StaticResource HoverOverlay}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VisibleCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            <Setter Property="FontSize" Value="13.5"/>
        </Style>

        <!-- A mock-up of the Schulnetz page, deliberately neutral and without school branding -->
        <SolidColorBrush x:Key="PortalBlue"  Color="#3B77B8"/>
        <SolidColorBrush x:Key="PortalText"  Color="#333333"/>
        <SolidColorBrush x:Key="PortalLink"  Color="#2F6DB0"/>
        <SolidColorBrush x:Key="Highlight"   Color="#F59E0B"/>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════════════
             LEFT: branding and the step rail
             ══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
                    <GradientStop Color="#5C6EF7" Offset="0"/>
                    <GradientStop Color="#3441B8" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="28,30,24,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="11" Background="#26FFFFFF">
                        <Image Source="pack://application:,,,/Resources/Semestra_Logo.png"
                               Width="30" Height="30"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="Semestria" Foreground="White" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="Einrichtung" Foreground="White" Opacity="0.7" FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <!-- The steps themselves, built in code -->
                <StackPanel x:Name="StepRail" Grid.Row="1" Margin="0,44,0,0"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Opacity="0.75">
                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="White" VerticalAlignment="Top" Margin="0,2,10,0"/>
                    <TextBlock Foreground="White" FontSize="12" TextWrapping="Wrap" MaxWidth="190"
                               LineHeight="18"
                               Text="Deine Daten bleiben auf diesem Gerät. Kein Konto bei uns, kein Server."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             RIGHT: content and footer
             ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto">
                <Grid Margin="48,40,48,24" MaxWidth="600" HorizontalAlignment="Left">

                    <!-- ══════════ STEP 1: welcome ══════════ -->
                    <StackPanel x:Name="Step1">
                        <TextBlock Text="WILLKOMMEN" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="Willkommen bei Semestria" Style="{StaticResource StepTitle}"/>
                        <TextBlock Style="{StaticResource StepLead}"
                                   Text="Semestria holt deine Prüfungen, Termine und Stunden aus dem Schulnetz und zeigt sie übersichtlich an. Auf Wunsch auch in Outlook. Die Einrichtung dauert etwa zwei Minuten."/>

                        <UniformGrid Columns="2">
                            <Border Style="{StaticResource Panel}" Margin="0,0,10,10">
                                <StackPanel>
                                    <Border Style="{StaticResource IconTile}" HorizontalAlignment="Left">
                                        <TextBlock Text="&#xE787;" Style="{StaticResource IconGlyph}"/>
                                    </Border>
                                    <TextBlock Text="Alles in einem Kalender" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                    <TextBlock Text="Prüfungen, Termine und dein Stundenplan, farbig nach Fach."
                                               FontSize="12.5" Opacity="0.7" TextWrapping="Wrap" LineHeight="18"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Panel}" Margin="0,0,0,10">
                                <StackPanel>
                                    <Border Style="{StaticResource IconTile}" HorizontalAlignment="Left">
                                        <TextBlock Text="&#xE895;" Style="{StaticResource IconGlyph}"/>
                                    </Border>
                                    <TextBlock Text="Immer aktuell" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                    <TextBlock Text="Verschobene oder abgesagte Einträge werden beim Laden erkannt."
                                               FontSize="12.5" Opacity="0.7" TextWrapping="Wrap" LineHeight="18"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Panel}" Margin="0,0,10,0">
                                <StackPanel>
                                    <Border Style="{StaticResource IconTile}" HorizontalAlignment="Left">
                                        <TextBlock Text="&#xE9D5;" Style="{StaticResource IconGlyph}"/>
                                    </Border>
                                    <TextBlock Text="Aufgaben dazu" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                    <TextBlock Text="Hausaufgaben und Abgaben mit Erinnerung, sortiert nach Fach."
                                               FontSize="12.5" Opacity="0.7" TextWrapping="Wrap" LineHeight="18"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Panel}">
                                <StackPanel>
                                    <Border Style="{StaticResource IconTile}" HorizontalAlignment="Left">
                                        <TextBlock Text="&#xE8A7;" Style="{StaticResource IconGlyph}"/>
                                    </Border>
                                    <TextBlock Text="Outlook, wenn du willst" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                    <TextBlock Text="Einträge landen auf Wunsch auch auf dem Handy und in Teams."
                                               FontSize="12.5" Opacity="0.7" TextWrapping="Wrap" LineHeight="18"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>

                    <!-- ══════════ STEP 2: legal ══════════ -->
                    <StackPanel x:Name="Step2" Visibility="Collapsed">
                        <TextBlock Text="SCHRITT 2 VON 5" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="Kurz das Kleingedruckte" Style="{StaticResource StepTitle}"/>
                        <TextBlock Style="{StaticResource StepLead}"
                                   Text="Semestria ist gratis und speichert nichts auf fremden Servern. Hier steht es schwarz auf weiss."/>

                        <Border Style="{StaticResource Panel}" Padding="0" Margin="0,0,0,14">
                            <TabControl BorderThickness="0" Background="Transparent" Margin="12,8,12,4">
                                <TabItem Header="Nutzungsbedingungen">
                                    <ScrollViewer Height="200" Padding="2,8,8,8" VerticalScrollBarVisibility="Auto">
                                        <TextBlock FontSize="12" TextWrapping="Wrap" Opacity="0.8" LineHeight="18"
                                                   Text="{x:Static legal:LegalTexts.Agb}"/>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="Datenschutzerklärung">
                                    <ScrollViewer Height="200" Padding="2,8,8,8" VerticalScrollBarVisibility="Auto">
                                        <TextBlock FontSize="12" TextWrapping="Wrap" Opacity="0.8" LineHeight="18"
                                                   Text="{x:Static legal:LegalTexts.Datenschutz}"/>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </Border>

                        <Border Style="{StaticResource Panel}" Padding="16,12">
                            <StackPanel>
                                <CheckBox x:Name="ChkAgb" Style="{StaticResource VisibleCheckBox}"
                                          Checked="Legal_CheckChanged" Unchecked="Legal_CheckChanged"
                                          Content="Ich habe die Nutzungsbedingungen gelesen und akzeptiere sie."/>
                                <Border Height="1" Background="{StaticResource SubtleBorder}" Margin="0,8"/>
                                <CheckBox x:Name="ChkDatenschutz" Style="{StaticResource VisibleCheckBox}"
                                          Checked="Legal_CheckChanged" Unchecked="Legal_CheckChanged"
                                          Content="Ich habe die Datenschutzerklärung gelesen und akzeptiere sie."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ══════════ STEP 3: feed URL ══════════ -->
                    <StackPanel x:Name="Step3" Visibility="Collapsed">
                        <TextBlock Text="SCHRITT 3 VON 5" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="Verbinde dein Schulnetz" Style="{StaticResource StepTitle}"/>
                        <TextBlock Style="{StaticResource StepLead}"
                                   Text="Semestria braucht deinen persönlichen Kalender-Link aus dem Schulnetz. So findest du ihn:"/>

                        <!-- 1 -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource NumberBadge}">
                                <TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="12.5"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Im Schulnetz anmelden" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,2"/>
                                <TextBlock Text="Im Browser, wie du es sonst auch tust."
                                           FontSize="13" Opacity="0.7" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <!-- 2 -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource NumberBadge}">
                                <TextBlock Text="2" Foreground="White" FontWeight="Bold" FontSize="12.5"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="schulNetz.mobile freigeben" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,2"/>
                                <TextBlock FontSize="13" Opacity="0.7" TextWrapping="Wrap" LineHeight="19">
                                    Auf der Seite <Run FontWeight="SemiBold">«Start»</Run> ganz nach unten scrollen bis zum Kasten
                                    <Run FontWeight="SemiBold">«schulNetz.mobile»</Run> und die Funktion freigeben.
                                    Ohne diesen Schritt gibt es keinen Kalender-Link.
                                </TextBlock>

                                <!-- Mock-up of the box -->
                                <Border Background="White" CornerRadius="8" Margin="0,12,0,0" Padding="16,14"
                                        BorderBrush="#D8DDE3" BorderThickness="1">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="schulNetz.mobile" Foreground="{StaticResource PortalText}"
                                                       FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="&#xE70E;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                       Foreground="{StaticResource PortalText}" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Foreground="{StaticResource PortalText}" FontSize="12" Opacity="0.85"
                                                   TextWrapping="Wrap" Margin="0,8,0,10" LineHeight="17"
                                                   Text="Drücken Sie auf den Link, um den Zugriff auf Ihre Daten über schulNetz.mobile freizugeben."/>
                                        <StackPanel Orientation="Horizontal">
                                            <Border BorderBrush="{StaticResource Highlight}" BorderThickness="2"
                                                    CornerRadius="5" Padding="8,3">
                                                <TextBlock Text="SCHULNETZ.MOBILE FREIGEBEN" Foreground="{StaticResource PortalLink}"
                                                           FontSize="11.5" FontWeight="SemiBold"/>
                                            </Border>
                                            <TextBlock Text="&#xE72B;  hier klicken" FontFamily="Segoe UI, Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       Foreground="#D97706" FontWeight="SemiBold" FontSize="12"
                                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock FontSize="12" Opacity="0.55" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="Steht dort schon «schulNetz.mobile sperren», ist die Funktion bereits aktiv."/>
                            </StackPanel>
                        </Grid>

                        <!-- 3 -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource NumberBadge}">
                                <TextBlock Text="3" Foreground="White" FontWeight="Bold" FontSize="12.5"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="iCal-Link kopieren" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,2"/>
                                <TextBlock FontSize="13" Opacity="0.7" TextWrapping="Wrap" LineHeight="19">
                                    Oben <Run FontWeight="SemiBold">«Agenda»</Run> öffnen, auf das Export-Symbol klicken und
                                    <Run FontWeight="SemiBold">«Diesen Plan im iCal Format abonnieren»</Run> wählen.
                                    Den angezeigten Link kopieren. Er beginnt mit webcal:// oder https://.
                                </TextBlock>

                                <Border Background="White" CornerRadius="8" Margin="0,12,0,0"
                                        BorderBrush="#D8DDE3" BorderThickness="1">
                                    <StackPanel>
                                        <Border Background="{StaticResource PortalBlue}" CornerRadius="7,7,0,0" Padding="14,8">
                                            <Grid>
                                                <TextBlock Text="Agenda" Foreground="White" FontWeight="SemiBold" FontSize="12.5"/>
                                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}"
                                                           Foreground="White" FontSize="13" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Margin="6,6,6,8">
                                            <TextBlock Padding="10,5" FontSize="12" Foreground="{StaticResource PortalText}" Opacity="0.7"
                                                       Text="Als PDF exportieren"/>
                                            <Border CornerRadius="5" Background="#FFF4E0" BorderBrush="{StaticResource Highlight}"
                                                    BorderThickness="2" Margin="2,1">
                                                <TextBlock Padding="8,5" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource PortalLink}"
                                                           Text="Diesen Plan im iCal Format abonnieren"/>
                                            </Border>
                                            <TextBlock Padding="10,5" FontSize="12" Foreground="{StaticResource PortalText}" Opacity="0.7"
                                                       Text="Im iCal Format herunterladen"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- 4: paste it in -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource NumberBadge}">
                                <TextBlock Text="4" Foreground="White" FontWeight="Bold" FontSize="12.5"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Hier einfügen" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtFeedUrl" Height="40" FontSize="13"
                                             VerticalContentAlignment="Center"
                                             ui:ControlHelper.PlaceholderText="webcal://…"
                                             TextChanged="TxtFeedUrl_TextChanged"/>
                                    <Button Grid.Column="1" Style="{StaticResource OutlineAction}"
                                            Margin="8,0,0,0" Padding="14,0"
                                            ToolTip="Link aus der Zwischenablage einfügen"
                                            Click="BtnPasteFeed_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE77F;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                       VerticalAlignment="Center" Margin="0,1,8,0"/>
                                            <TextBlock Text="Einfügen" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="2,8,0,0">
                                    <TextBlock x:Name="FeedStatusGlyph" Text="&#xE72E;" FontFamily="{StaticResource IconFont}"
                                               FontSize="12" Opacity="0.55" VerticalAlignment="Top" Margin="0,2,8,0"/>
                                    <TextBlock x:Name="TxtFeedStatus" FontSize="12" Opacity="0.55" TextWrapping="Wrap"
                                               MaxWidth="480"
                                               Text="Der Link wird verschlüsselt gespeichert und verlässt dein Gerät nie."/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- ══════════ STEP 4: Outlook ══════════ -->
                    <Grid x:Name="Step4" Visibility="Collapsed">

                        <!-- 4a: the question -->
                        <StackPanel x:Name="Step4Ask">
                            <TextBlock Text="SCHRITT 4 VON 5 · OPTIONAL" Style="{StaticResource Eyebrow}"/>
                            <TextBlock Text="Auch in Outlook anzeigen?" Style="{StaticResource StepTitle}"/>
                            <TextBlock Style="{StaticResource StepLead}"
                                       Text="{x:Static local:OutlookSetupText.Benefit}"/>

                            <Button x:Name="BtnLinkNow" Style="{StaticResource ChoiceCard}"
                                    Margin="0,0,0,10" Click="BtnLinkNow_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8A7;" Style="{StaticResource IconGlyph}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="Ja, Outlook verknüpfen" FontSize="14.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Einmal mit Microsoft anmelden, danach läuft alles von selbst."
                                                   FontSize="12.5" Opacity="0.65" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="{StaticResource IconFont}"
                                               FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <Button x:Name="BtnLinkLater" Style="{StaticResource ChoiceCard}"
                                    Margin="0,0,0,18" Click="BtnLinkLater_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}" VerticalAlignment="Center"
                                            Background="{StaticResource SubtleFill}">
                                        <TextBlock Text="&#xE823;" Style="{StaticResource IconGlyph}"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                                   Opacity="0.7"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="Später, erst mal ohne Outlook" FontSize="14.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Static local:OutlookSetupText.SkipConsequence}"
                                                   FontSize="12.5" Opacity="0.65" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="{StaticResource IconFont}"
                                               FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- Developer builds without a registration of their own -->
                            <Border x:Name="NoRegistrationHint" Visibility="Collapsed"
                                    CornerRadius="10" Padding="14,10"
                                    Background="#1FF59E0B" BorderBrush="#66F59E0B" BorderThickness="1">
                                <TextBlock FontSize="12" TextWrapping="Wrap"
                                           Text="Diese Version bringt keine App-Registrierung mit. Für den Outlook-Sync brauchst du eine eigene App-ID, die Anleitung dazu erscheint im nächsten Schritt."/>
                            </Border>
                        </StackPanel>

                        <!-- 4b: signing in -->
                        <StackPanel x:Name="Step4Setup" Visibility="Collapsed">
                            <TextBlock Text="SCHRITT 4 VON 5 · OUTLOOK" Style="{StaticResource Eyebrow}"/>
                            <TextBlock Text="Mit Microsoft anmelden" Style="{StaticResource StepTitle}"/>
                            <TextBlock Style="{StaticResource StepLead}"
                                       Text="{x:Static local:OutlookSetupText.HowItWorks}"/>

                            <Border Style="{StaticResource Panel}" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="Was Semestria darf" FontWeight="SemiBold" FontSize="13.5" Margin="0,0,0,12"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   Foreground="{StaticResource SuccessBrush}" Margin="0,2,12,0"/>
                                        <TextBlock FontSize="13" TextWrapping="Wrap" MaxWidth="500"
                                                   Text="Prüfungen und Termine in deinen Kalender eintragen und aktuell halten"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   Foreground="{StaticResource DangerBrush}" Margin="0,2,12,0"/>
                                        <TextBlock FontSize="13" TextWrapping="Wrap" MaxWidth="500"
                                                   Text="Keine E-Mails, keine Kontakte, keine Dateien"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   Opacity="0.7" Margin="0,2,12,0"/>
                                        <TextBlock FontSize="13" TextWrapping="Wrap" MaxWidth="500"
                                                   Text="Du meldest dich direkt bei Microsoft an. Semestria sieht dein Passwort nie."/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Button x:Name="BtnSignIn" Style="{StaticResource AccentAction}"
                                    HorizontalAlignment="Left" Height="44" Padding="24,0"
                                    Click="BtnSignIn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                               VerticalAlignment="Center" Margin="0,1,10,0"/>
                                    <TextBlock Text="Mit Microsoft anmelden" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Border x:Name="SignInSuccess" Visibility="Collapsed"
                                    CornerRadius="10" Padding="14,12" HorizontalAlignment="Left"
                                    Background="#1F22C55E" BorderBrush="#6622C55E" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                               Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"
                                               Margin="0,1,10,0"/>
                                    <TextBlock x:Name="TxtSignedIn" Text="Erfolgreich angemeldet. Weiter geht's."
                                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="TxtSignInError" Visibility="Collapsed"
                                       TextWrapping="Wrap" FontSize="12.5"
                                       Foreground="{StaticResource DangerBrush}" Margin="0,10,0,0"/>

                            <!--
                                Only visible when this build ships without an app
                                registration of its own. End users never see it.
                            -->
                            <Expander x:Name="AdvancedIdSection" Header="Eigene App-ID verwenden"
                                      Visibility="Collapsed" Margin="0,24,0,0">
                                <StackPanel Margin="0,12,0,0">
                                    <Border CornerRadius="10" Padding="14,10" Margin="0,0,0,14"
                                            Background="#1FF59E0B" BorderBrush="#66F59E0B" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="Diese Version bringt keine App-Registrierung mit"
                                                       FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                            <TextBlock FontSize="12" TextWrapping="Wrap" Opacity="0.9"
                                                       Text="{x:Static local:OutlookSetupText.AccountWarning}"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBox x:Name="TxtClientId" Height="36" FontSize="13"
                                             ui:ControlHelper.PlaceholderText="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
                                             TextChanged="TxtClientId_TextChanged"/>
                                    <TextBlock x:Name="ClientIdHint" FontSize="12" Opacity="0.6" Margin="0,6,0,14"
                                               TextWrapping="Wrap" Text="Noch leer. Folge der Anleitung unten."/>

                                    <Border Style="{StaticResource Panel}" Margin="0,0,0,12" Padding="14,12">
                                        <ItemsControl ItemsSource="{x:Static local:OutlookSetupText.Steps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"
                                                               Opacity="0.88" Margin="0,0,0,6"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>

                                    <Button x:Name="BtnOpenAzure" Content="Microsoft-Portal öffnen"
                                            Style="{StaticResource OutlineAction}" HorizontalAlignment="Left"
                                            Click="BtnOpenAzure_Click"/>
                                </StackPanel>
                            </Expander>

                            <Button x:Name="BtnSkipSignIn" Content="Doch später einrichten"
                                    Style="{StaticResource LinkAction}" HorizontalAlignment="Left"
                                    Margin="-10,18,0,0" Click="BtnSkipSignIn_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- ══════════ STEP 5: done ══════════ -->
                    <StackPanel x:Name="Step5" Visibility="Collapsed">
                        <Border Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Left"
                                Background="#2622C55E" Margin="0,0,0,20">
                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="30"
                                       Foreground="{StaticResource SuccessBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Alles bereit!" Style="{StaticResource StepTitle}"/>
                        <TextBlock Style="{StaticResource StepLead}"
                                   Text="Semestria ist eingerichtet. Beim Start lädt die App deine Daten und zeigt dir, was ansteht."/>

                        <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                            <StackPanel x:Name="SummaryList"/>
                        </Border>

                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <CheckBox x:Name="ChkAutoRefresh" IsChecked="True"
                                          Style="{StaticResource VisibleCheckBox}"
                                          Content="Feed beim App-Start automatisch aktualisieren"/>
                                <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="28,4,0,0"
                                           LineHeight="17"
                                           Text="Hält deinen Kalender auf dem neuesten Stand. Ohne Internet nutzt Semestria die zuletzt geladenen Daten."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>

            <!-- ══════════ Footer ══════════ -->
            <Border Grid.Row="1" BorderBrush="{StaticResource SubtleBorder}" BorderThickness="0,1,0,0"
                    Padding="48,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnBack" Style="{StaticResource OutlineAction}"
                            IsEnabled="False" Click="BtnBack_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE76B;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,1,8,0"/>
                            <TextBlock Text="Zurück" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="TxtStepCounter" Grid.Column="1" Text="1 / 5" FontSize="12.5" Opacity="0.5"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button x:Name="BtnNext" Grid.Column="2" Style="{StaticResource AccentAction}"
                            Click="BtnNext_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtNextLabel" Text="Los geht's" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       VerticalAlignment="Center" Margin="10,1,0,0"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
