<Window x:Class="SchulnetzSync.UI.Onboarding.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:legal="clr-namespace:SchulnetzSync.UI.Legal"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="SchulnetzSync einrichten"
        Width="660" Height="640"
        MinWidth="560" MinHeight="540"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Weisses Kontrollkästchen: gut sichtbar in Hell- und Dunkel-Modus -->
        <Style x:Key="VisibleCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground"
                    Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Akzentstreifen oben -->
        <Border Grid.Row="0" Background="{StaticResource AccentBrush}"/>

        <!-- Schritt-Inhalte -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Padding="52,36,52,16">
            <Grid>

                <!-- ══════════════════════════════════
                     SCHRITT 1 — Willkommen
                     ══════════════════════════════════ -->
                <StackPanel x:Name="Step1" HorizontalAlignment="Center" MaxWidth="520">
                    <TextBlock Text="👋" FontSize="60"
                               HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="Willkommen bei SchulnetzSync"
                               FontSize="26" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock TextAlignment="Center" TextWrapping="Wrap"
                               FontSize="14" Opacity="0.65" Margin="0,0,0,28"
                               Text="Schulprüfungen und Termine automatisch in deinen Outlook-Kalender. In 4 Schritten eingerichtet."/>
                    <Border Style="{StaticResource InfoBox}">
                        <StackPanel>
                            <TextBlock Text="Was SchulnetzSync macht:"
                                       FontWeight="SemiBold" FontSize="14"
                                       Margin="0,0,0,12"/>
                            <TextBlock FontSize="13" Margin="0,0,0,6">✅  Liest deinen Schulnetz-Kalender automatisch</TextBlock>
                            <TextBlock FontSize="13" Margin="0,0,0,6">✅  Schreibt Prüfungen &amp; Termine in Outlook</TextBlock>
                            <TextBlock FontSize="13" Margin="0,0,0,6">✅  Erkennt Änderungen und aktualisiert Einträge</TextBlock>
                            <TextBlock FontSize="13">🔒  Alles lokal — keine Daten auf fremden Servern</TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ══════════════════════════════════
                     SCHRITT 2 — Nutzungsbedingungen
                     ══════════════════════════════════ -->
                <StackPanel x:Name="Step2" Visibility="Collapsed"
                            HorizontalAlignment="Center" MaxWidth="540">
                    <TextBlock Text="📋" FontSize="48"
                               HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="Nutzungsbedingungen und Datenschutz"
                               FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock TextAlignment="Center" TextWrapping="Wrap"
                               FontSize="13" Opacity="0.65" Margin="0,0,0,16"
                               Text="Bitte lies und akzeptiere die folgenden Dokumente, bevor du fortfährst."/>

                    <TabControl Margin="0,0,0,16" BorderThickness="1">
                        <TabItem Header="Nutzungsbedingungen">
                            <ScrollViewer Height="180" Padding="4"
                                          VerticalScrollBarVisibility="Auto">
                                <TextBlock FontFamily="Consolas" FontSize="11"
                                           TextWrapping="Wrap" Opacity="0.8"
                                           LineHeight="17"
                                           Text="{x:Static legal:LegalTexts.Agb}"/>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Datenschutzerklärung">
                            <ScrollViewer Height="180" Padding="4"
                                          VerticalScrollBarVisibility="Auto">
                                <TextBlock FontFamily="Consolas" FontSize="11"
                                           TextWrapping="Wrap" Opacity="0.8"
                                           LineHeight="17"
                                           Text="{x:Static legal:LegalTexts.Datenschutz}"/>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>

                    <CheckBox x:Name="ChkAgb"
                              Style="{StaticResource VisibleCheckBox}"
                              Checked="Legal_CheckChanged"
                              Unchecked="Legal_CheckChanged"
                              Content="Ich habe die Nutzungsbedingungen gelesen und akzeptiere sie."/>
                    <CheckBox x:Name="ChkDatenschutz"
                              Style="{StaticResource VisibleCheckBox}"
                              Checked="Legal_CheckChanged"
                              Unchecked="Legal_CheckChanged"
                              Content="Ich habe die Datenschutzerklärung gelesen und akzeptiere sie."/>
                </StackPanel>

                <!-- ══════════════════════════════════
                     SCHRITT 3 — Feed-URL
                     ══════════════════════════════════ -->
                <StackPanel x:Name="Step3" Visibility="Collapsed"
                            HorizontalAlignment="Center" MaxWidth="520">
                    <TextBlock Text="📡" FontSize="48"
                               HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="Schulnetz Feed-URL"
                               FontSize="24" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock TextAlignment="Center" TextWrapping="Wrap"
                               FontSize="13" Opacity="0.65" Margin="0,0,0,20"
                               Text="Dein persönlicher Kalender-Link aus dem Schulnetz-Portal."/>

                    <!-- Anleitung als Schritte -->
                    <TextBlock Text="So findest du die URL:"
                               FontWeight="SemiBold" FontSize="13"
                               Margin="0,0,0,10"/>
                    <Border Style="{StaticResource InfoBox}" Margin="0,0,0,4">
                        <StackPanel>
                            <TextBlock FontSize="13" Margin="0,0,0,6">1.  Melde dich im Schulnetz-Portal an</TextBlock>
                            <TextBlock FontSize="13" Margin="0,0,0,6">2.  Gehe zu «Stundenplan» oder «Kalender»</TextBlock>
                            <TextBlock FontSize="13" Margin="0,0,0,6">3.  Klicke auf das Download-Symbol (Pfeil nach unten)</TextBlock>
                            <TextBlock FontSize="13" Margin="0,0,0,6">4.  Wähle «Diesen Plan im iCal Format abonnieren»</TextBlock>
                            <TextBlock FontSize="13">5.  Kopiere den Link (beginnt mit webcal:// oder https://)</TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Schulnetz-Mockup: zeigt wo geklickt wird -->
                    <Border CornerRadius="8" Margin="0,12,0,16"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                        <StackPanel>
                            <!-- Portal-Header -->
                            <Border Background="#0066CC" CornerRadius="7,7,0,0"
                                    Padding="14,10">
                                <TextBlock Text="Schülerinnen- und Schülerplan"
                                           Foreground="White" FontWeight="SemiBold"
                                           FontSize="13"/>
                            </Border>
                            <!-- Symbolleiste -->
                            <Border Background="White" Padding="10,6">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Border Background="#0066CC" CornerRadius="4"
                                            Padding="8,4" Margin="4,0,0,0">
                                        <TextBlock Text="⬇  Exportieren"
                                                   Foreground="White" FontSize="12"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <!-- Dropdown-Menü -->
                            <Border Background="White" Padding="6"
                                    BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
                                <StackPanel>
                                    <TextBlock Padding="10,6" FontSize="12"
                                               Foreground="#444">📄  Als PDF exportieren</TextBlock>
                                    <TextBlock Padding="10,6" FontSize="12"
                                               Foreground="#444">📋  Als Liste exportieren</TextBlock>
                                    <!-- Markierte Option -->
                                    <Border Background="#E8F0FE" CornerRadius="4"
                                            Margin="4,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Padding="10,8" FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#0066CC">📅  Diesen Plan im iCal Format abonnieren</TextBlock>
                                            <TextBlock FontSize="11" FontWeight="Bold"
                                                       Foreground="#E53935"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0">← Hier</TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Padding="10,6" FontSize="12"
                                               Foreground="#444">📥  Im iCal-Format herunterladen</TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- URL-Eingabe -->
                    <TextBlock Text="Feed-URL einfügen:"
                               FontWeight="SemiBold" FontSize="13"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtFeedUrl" Height="38" FontSize="13"
                             ui:ControlHelper.PlaceholderText="webcal://schulnetz.example.ch/ical?token=..."
                             TextChanged="TxtFeedUrl_TextChanged"/>
                    <TextBlock x:Name="TxtFeedStatus" FontSize="12"
                               Opacity="0.55" Margin="0,6,0,0"
                               Text="🔒  Die URL wird verschlüsselt gespeichert. Das Token verlässt dein Gerät nie."/>
                </StackPanel>

                <!-- ══════════════════════════════════
                     SCHRITT 4 — Microsoft-Anmeldung
                     ══════════════════════════════════ -->
                <StackPanel x:Name="Step4" Visibility="Collapsed"
                            HorizontalAlignment="Center" MaxWidth="520">
                    <TextBlock Text="🔑" FontSize="48"
                               HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="Mit Microsoft anmelden"
                               FontSize="24" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock TextAlignment="Center" TextWrapping="Wrap"
                               FontSize="13" Opacity="0.65" Margin="0,0,0,20"
                               Text="Dieser Schritt ist optional. Du kannst ihn überspringen und den In-App-Kalender nutzen — oder später in den Einstellungen einrichten."/>

                    <Border Style="{StaticResource InfoBox}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Wozu ist die Outlook-Anmeldung gut?"
                                       FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock FontSize="13" Margin="0,0,0,4">✅  Prüfungen erscheinen direkt in Outlook und Teams</TextBlock>
                            <TextBlock FontSize="13" Margin="0,0,0,4">✅  Benachrichtigungen auf allen deinen Geräten</TextBlock>
                            <TextBlock FontSize="13" Margin="0,0,0,4">❌  Keine E-Mails, Kontakte oder anderen Daten</TextBlock>
                            <TextBlock FontSize="13" Opacity="0.7" Margin="0,8,0,0">
                                Ohne Anmeldung: In-App-Kalender funktioniert trotzdem vollständig.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Client-ID Warnung (nur wenn Platzhalter) -->
                    <Border x:Name="ClientIdHint"
                            Style="{StaticResource WarningBox}"
                            Visibility="Collapsed" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="App-ID noch nicht konfiguriert"
                                       FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.85"
                                       Text="Für die Anmeldung wird eine Microsoft App-ID benötigt. Trage sie unten ein oder überspringe diesen Schritt."/>
                        </StackPanel>
                    </Border>

                    <!-- App-ID Eingabe mit Hilfe-Link -->
                    <StackPanel Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="App-ID (Client-ID):"
                                       FontWeight="SemiBold" FontSize="13"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="BtnOpenAzure"
                                    Content="Auf portal.azure.com öffnen"
                                    FontSize="11"
                                    Margin="12,0,0,0"
                                    Padding="8,3"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="BtnOpenAzure_Click"/>
                        </StackPanel>
                        <TextBox x:Name="TxtClientId" Height="38" FontSize="13"
                                 ui:ControlHelper.PlaceholderText="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
                                 TextChanged="TxtClientId_TextChanged"/>
                    </StackPanel>

                    <!-- Azure-Anleitung -->
                    <Border CornerRadius="6" Padding="14,12"
                            Margin="0,8,0,12"
                            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                        <StackPanel>
                            <TextBlock Text="Wichtig: persönliches Microsoft-Konto nötig"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource WarningBrush}"
                                       Margin="0,0,0,8"/>
                            <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8">
                                Schulkonten (@altekanti.ch usw.) haben meist keine Rechte um Apps zu registrieren. Du brauchst ein persönliches Microsoft-Konto (@outlook.com, @hotmail.com oder @live.com).
                            </TextBlock>
                            <TextBlock Text="Schritte:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3">1.  «Auf portal.azure.com öffnen» klicken und mit persönlichem Konto anmelden</TextBlock>
                            <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3">2.  «App-Registrierungen» → «Neue Registrierung»</TextBlock>
                            <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3">3.  Name: SchulnetzSync, Typ: Persönliche Microsoft-Konten</TextBlock>
                            <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3">4.  «Anwendungs-ID (Client-ID)» kopieren und oben einfügen</TextBlock>
                            <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3">5.  API-Berechtigungen: Calendars.ReadWrite (delegiert)</TextBlock>
                            <TextBlock FontSize="12" TextWrapping="Wrap">6.  Authentifizierung: Öffentlicher Client/native Anwendung aktivieren</TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Anmelde-Button -->
                    <Button x:Name="BtnSignIn"
                            Content="Jetzt mit Microsoft anmelden"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Center"
                            Padding="28,12" FontSize="14"
                            IsEnabled="False"
                            Click="BtnSignIn_Click"
                            Margin="0,0,0,12"/>

                    <!-- Erfolg -->
                    <StackPanel x:Name="SignInSuccess" Visibility="Collapsed"
                                Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="✅" FontSize="18" VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtSignedIn"
                                   Text="Erfolgreich angemeldet!"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource SuccessBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Fehler -->
                    <TextBlock x:Name="TxtSignInError"
                               Visibility="Collapsed"
                               TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource DangerBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>

                    <!-- Überspringen -->
                    <TextBlock Margin="0,16,0,4" HorizontalAlignment="Center"
                               FontSize="12" Opacity="0.55" TextWrapping="Wrap"
                               TextAlignment="Center"
                               Text="Keine App-ID? Du kannst diesen Schritt überspringen und später in den Einstellungen konfigurieren."/>
                    <Button x:Name="BtnSkipSignIn"
                            Content="Überspringen"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,0"
                            FontSize="12"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource AccentBrush}"
                            Cursor="Hand"
                            Click="BtnSkipSignIn_Click"/>
                </StackPanel>

                <!-- ══════════════════════════════════
                     SCHRITT 5 — Fertig
                     ══════════════════════════════════ -->
                <StackPanel x:Name="Step5" Visibility="Collapsed"
                            HorizontalAlignment="Center" MaxWidth="460">
                    <TextBlock Text="🎉" FontSize="72"
                               HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="Alles bereit!"
                               FontSize="28" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock TextAlignment="Center" TextWrapping="Wrap"
                               FontSize="14" Opacity="0.65" Margin="0,0,0,28"
                               Text="SchulnetzSync ist eingerichtet. Du kannst jetzt deine Prüfungen synchronisieren."/>
                    <Border Style="{StaticResource SuccessBox}">
                        <TextBlock x:Name="TxtSetupSummary"
                                   TextWrapping="Wrap" FontSize="13"
                                   LineHeight="22"/>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>

        <!-- Fortschritts-Punkte -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,8,0,12">
            <Ellipse x:Name="Dot1" Width="10" Height="10" Margin="5,0"
                     Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
            <Ellipse x:Name="Dot2" Width="8"  Height="8"  Margin="5,0"
                     Fill="{DynamicResource SystemControlForegroundBaseLowBrush}"
                     VerticalAlignment="Center"/>
            <Ellipse x:Name="Dot3" Width="8"  Height="8"  Margin="5,0"
                     Fill="{DynamicResource SystemControlForegroundBaseLowBrush}"
                     VerticalAlignment="Center"/>
            <Ellipse x:Name="Dot4" Width="8"  Height="8"  Margin="5,0"
                     Fill="{DynamicResource SystemControlForegroundBaseLowBrush}"
                     VerticalAlignment="Center"/>
            <Ellipse x:Name="Dot5" Width="8"  Height="8"  Margin="5,0"
                     Fill="{DynamicResource SystemControlForegroundBaseLowBrush}"
                     VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Navigation -->
        <Border Grid.Row="3"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0" Padding="32,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnBack" Grid.Column="0"
                        Content="Zurück"
                        Style="{StaticResource SecondaryButton}"
                        IsEnabled="False"
                        Click="BtnBack_Click"/>
                <Button x:Name="BtnNext" Grid.Column="2"
                        Content="Weiter"
                        Style="{StaticResource PrimaryButton}"
                        Padding="24,10"
                        Click="BtnNext_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
