<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SchulnetzSync.Core\SchulnetzSync.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModernWpfUI" Version="0.9.6" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Needed for System.Windows.Forms.NotifyIcon (tray icon) -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- App-Icon (.ico) für Explorer und Taskleiste -->
    <ApplicationIcon>Resources\semestria.ico</ApplicationIcon>
    <!-- Assemblymetadaten -->
    <AssemblyTitle>Semestria</AssemblyTitle>
    <Product>Semestria</Product>
    <Company>Elias Wyss</Company>
    <Copyright>© 2025 Elias Wyss</Copyright>
  </PropertyGroup>

  <!-- Icon als eingebettete Ressource einschliessen -->
  <ItemGroup>
    <Resource Include="Resources\semestria.ico"/>
  </ItemGroup>

</Project>
