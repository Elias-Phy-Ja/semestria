# semestria.elias-wyss.ch on Hostinger (Apache / LiteSpeed)

Options -Indexes

# Always HTTPS
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Frame-Options "DENY"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
</IfModule>

# The app fetches this some seconds after every start; five minutes of caching is plenty
<Files "news.json">
    <IfModule mod_headers.c>
        Header set Cache-Control "public, max-age=300"
        Header set Content-Type "application/json; charset=utf-8"
    </IfModule>
</Files>

# Never serve hidden files or backups
<FilesMatch "(^\.|\.(bak|tmp|lock|log|md)$)">
    Require all denied
</FilesMatch>
