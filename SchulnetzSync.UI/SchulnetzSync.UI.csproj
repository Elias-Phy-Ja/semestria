<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SchulnetzSync.Core\SchulnetzSync.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModernWpfUI" Version="0.9.6" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      Die Windows-Version im TFM schaltet die WinRT-Projektion frei, ohne die
      es Windows.Services.Store nicht gibt. 17763 statt eines höheren Werts,
      weil Packaging\Package.appxmanifest Windows 10 1809 als Minimum angibt —
      ein höheres TFM würde Geräte zwischen 1809 und 1909 beim Start abstürzen
      lassen, obwohl der Store ihnen die App anbietet.
    -->
    <TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Needed for System.Windows.Forms.NotifyIcon (tray icon) -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- App-Icon (.ico) für Explorer und Taskleiste -->
    <ApplicationIcon>Resources\semestria.ico</ApplicationIcon>
    <!-- Assemblymetadaten -->
    <AssemblyTitle>Semestria</AssemblyTitle>
    <Product>Semestria</Product>
    <Company>Elias Wyss</Company>
    <Copyright>© 2025 Elias Wyss</Copyright>
  </PropertyGroup>

  <!-- Icons und Bilder als eingebettete Ressourcen -->
  <ItemGroup>
    <Resource Include="Resources\semestria.ico"/>
    <Resource Include="Resources\Semestra_Logo.png"/>
  </ItemGroup>

</Project>
