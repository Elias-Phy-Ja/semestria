<Window x:Class="SchulnetzSync.UI.News.NewsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Neuigkeiten von Semestria"
        Width="520" SizeToContent="Height" MaxHeight="680"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Neuigkeiten" FontSize="22" FontWeight="Bold" Margin="0,0,0,14"/>

        <!-- One card per message, filled in code -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Items"/>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="Nachrichten lassen sich in den Einstellungen ausschalten."
                       FontSize="11" Opacity="0.55" VerticalAlignment="Center"/>
            <Button x:Name="BtnClose" Content="Schliessen" HorizontalAlignment="Right"
                    Style="{StaticResource PrimaryButton}" IsDefault="True" IsCancel="True"
                    Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
