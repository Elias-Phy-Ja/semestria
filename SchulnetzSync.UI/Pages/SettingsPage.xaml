<Page x:Class="SchulnetzSync.UI.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:local="clr-namespace:SchulnetzSync.UI"
      Title="Einstellungen">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32" MaxWidth="660">

            <TextBlock Text="Einstellungen"
                       Style="{StaticResource TitleText}"
                       Margin="0,0,0,24"/>

            <!-- ═══ DARSTELLUNG ═══ -->
            <TextBlock Text="DARSTELLUNG" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Erscheinungsbild"
                               Style="{StaticResource HeadlineText}"
                               Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <RadioButton x:Name="RbSystem" GroupName="Theme"
                                     Content="System"
                                     IsChecked="True"
                                     Margin="0,0,24,0"
                                     Checked="Theme_Changed" Tag="System"/>
                        <RadioButton x:Name="RbLight" GroupName="Theme"
                                     Content="Hell"
                                     Margin="0,0,24,0"
                                     Checked="Theme_Changed" Tag="Light"/>
                        <RadioButton x:Name="RbDark" GroupName="Theme"
                                     Content="Dunkel"
                                     Checked="Theme_Changed" Tag="Dark"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource NoteText}"
                               Text="Wechselt sofort — kein Neustart nötig."/>
                </StackPanel>
            </Border>

            <!-- ═══ FEED-URL ═══ -->
            <TextBlock Text="SCHULNETZ" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Feed-URL"
                               Style="{StaticResource HeadlineText}"
                               Margin="0,0,0,8"/>
                    <TextBox x:Name="TxtFeedUrl" Height="36" FontSize="13"
                             ui:ControlHelper.PlaceholderText="webcal://schulnetz.example.ch/ical?token=…"/>
                    <TextBlock Style="{StaticResource NoteText}"
                               Text="🔒  Enthält dein persönliches Token. Wird verschlüsselt gespeichert und verlässt dein Gerät nie."/>
                </StackPanel>
            </Border>

            <!-- ═══ MICROSOFT ═══ -->
            <TextBlock Text="OUTLOOK (OPTIONAL)" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>

                    <!-- Status-Indikator -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Ellipse x:Name="AccountDot" Width="10" Height="10"
                                 Fill="#9CA3AF"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtAccountStatus"
                                   Style="{StaticResource HeadlineText}"
                                   Text="Status wird geprüft…"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtAccountDetail"
                               Style="{StaticResource NoteText}"
                               Margin="0,0,0,16"/>

                    <!-- Wozu das Ganze -->
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,10"
                               Text="{x:Static local:OutlookSetupText.Benefit}"/>
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,16"
                               Text="{x:Static local:OutlookSetupText.SkipConsequence}"/>

                    <Border Style="{StaticResource InfoBox}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock FontSize="13" TextWrapping="Wrap" Margin="0,0,0,6">&#x2705;  Pr&#252;fungen und Termine in deinem Kalender, immer aktuell</TextBlock>
                            <TextBlock FontSize="13" TextWrapping="Wrap" Margin="0,0,0,6">&#x274C;  Keine E-Mails, keine Kontakte, keine Dateien</TextBlock>
                            <TextBlock FontSize="13" TextWrapping="Wrap">&#x1F512;  Du meldest dich direkt bei Microsoft an. Semestria sieht dein Passwort nie.</TextBlock>
                        </StackPanel>
                    </Border>

                    <!--
                        Normalfall: Die App bringt ihre Registrierung mit, hier ist
                        nichts einzutragen. Der Abschnitt ist nur f&#252;r Fortgeschrittene
                        und f&#252;r Builds ohne mitgelieferte App-ID.
                    -->
                    <Expander x:Name="AdvancedIdSection"
                              Header="Erweitert: eigene App-ID verwenden"
                              Margin="0,0,0,16">
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,12"
                                       Text="Normalerweise brauchst du hier nichts einzutragen &#8212; Semestria bringt seine eigene Registrierung mit. Trage nur dann eine App-ID ein, wenn du eine eigene Registrierung bei Microsoft verwenden willst."/>

                            <TextBox x:Name="TxtClientId" Height="36" FontSize="13"
                                     ui:ControlHelper.PlaceholderText="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"/>
                            <TextBlock Style="{StaticResource NoteText}" Margin="0,6,0,14"
                                       Text="Leer lassen, um die mitgelieferte Registrierung zu verwenden."/>

                            <Border Style="{StaticResource WarningBox}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Wichtig: privates Microsoft-Konto"
                                               FontWeight="SemiBold" FontSize="13"
                                               Margin="0,0,0,6"/>
                                    <TextBlock FontSize="12" TextWrapping="Wrap" Opacity="0.90"
                                               Text="{x:Static local:OutlookSetupText.AccountWarning}"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="So kommst du zu einer eigenen App-ID:"
                                       FontWeight="SemiBold" FontSize="13"
                                       Margin="0,0,0,8"/>
                            <Border CornerRadius="8" Padding="14,12" Margin="0,0,0,12"
                                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                                <ItemsControl ItemsSource="{x:Static local:OutlookSetupText.Steps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       FontSize="12" TextWrapping="Wrap"
                                                       Opacity="0.88" Margin="0,0,0,6"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <Button x:Name="BtnOpenAzure"
                                    Content="Microsoft-Portal &#246;ffnen"
                                    Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left"
                                    Padding="16,8" FontSize="13"
                                    Click="BtnOpenAzure_Click"/>
                        </StackPanel>
                    </Expander>

                    <!-- Anmelde-Buttons -->
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnSignIn"
                                Content="Mit Microsoft anmelden"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,12,0"
                                Click="BtnSignIn_Click"/>
                        <Button x:Name="BtnSignOut"
                                Content="Abmelden"
                                Style="{StaticResource SecondaryButton}"
                                IsEnabled="False"
                                Click="BtnSignOut_Click"/>
                    </StackPanel>

                    <!-- Fehler -->
                    <TextBlock x:Name="TxtAuthError"
                               Visibility="Collapsed"
                               TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource DangerBrush}"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- ═══ KALENDER ═══ -->
            <TextBlock Text="KALENDER" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Ziel-Kalender"
                               Style="{StaticResource HeadlineText}"
                               Margin="0,0,0,8"/>
                    <ComboBox x:Name="CmbCalendar" Height="36" FontSize="13"
                              ui:ControlHelper.PlaceholderText="Primärer Kalender (Standard)"
                              SelectionChanged="CmbCalendar_SelectionChanged"/>
                    <TextBlock Style="{StaticResource NoteText}"
                               Text="Leer lassen für den primären Kalender."/>
                </StackPanel>
            </Border>

            <!-- ═══ OPTIONEN ═══ -->
            <TextBlock Text="SYNCHRONISATION" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox x:Name="ChkPruefungen"
                              Content="Prüfungen synchronisieren"
                              Margin="0,0,0,10" IsChecked="True"/>
                    <CheckBox x:Name="ChkTermine"
                              Content="Schultermine synchronisieren"
                              Margin="0,0,0,10" IsChecked="True"/>
                    <Separator Style="{StaticResource Divider}"/>
                    <CheckBox x:Name="ChkCancel" IsChecked="True"
                              Margin="0,6,0,4"
                              Content="Verschwundene Einträge als «Abgesagt» markieren (statt löschen)"/>
                    <TextBlock Style="{StaticResource NoteText}" Margin="24,0,0,8"
                               Text="Empfohlen: vergangene Prüfungen bleiben so sichtbar."/>
                    <CheckBox x:Name="ChkEnrich" IsChecked="True"
                              Margin="0,0,0,0"
                              Content="Prüfungs-Raum aus gleichzeitiger Lektion ergänzen"/>
                    <Separator Style="{StaticResource Divider}" Margin="0,10,0,6"/>
                    <CheckBox x:Name="ChkAutoRefresh" IsChecked="True"
                              Margin="0,0,0,4"
                              Content="Feed beim App-Start automatisch aktualisieren"/>
                    <TextBlock Style="{StaticResource NoteText}" Margin="24,0,0,0"
                               Text="Aktualisiert den Kalender im Hintergrund. Wenn offline, wird der gespeicherte Feed genutzt."/>
                </StackPanel>
            </Border>

            <!-- ═══ AUFRÄUMEN ═══ -->
            <TextBlock Text="AUFRÄUMEN" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Alle Semestria-Einträge aus Outlook entfernen"
                               Style="{StaticResource HeadlineText}"
                               Margin="0,0,0,8"/>
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,6"
                               Text="Löscht jeden Kalendereintrag, den Semestria angelegt hat — Prüfungen und Termine, auch bereits als «Abgesagt» markierte."/>
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,6"
                               Text="Deine eigenen Termine bleiben unberührt. Erkannt werden nur Einträge, die Semestria selbst erstellt und markiert hat."/>
                    <TextBlock Style="{StaticResource NoteText}" Margin="0,0,0,14"
                               Text="Lässt sich nicht rückgängig machen. Ein erneuter Sync legt die Einträge aber wieder an."/>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnPurgeAll"
                                Content="Alle Einträge löschen"
                                Style="{StaticResource SecondaryButton}"
                                Foreground="{StaticResource DangerBrush}"
                                Click="BtnPurgeAll_Click"/>
                        <ui:ProgressRing x:Name="PurgeRing"
                                         IsActive="False" Width="20" Height="20"
                                         VerticalAlignment="Center"
                                         Margin="14,0,0,0"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtPurgeStatus"
                               Style="{StaticResource BodyText}"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- Speichern -->
            <StackPanel Orientation="Horizontal">
                <Button Content="💾  Einstellungen speichern"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,16,0"
                        Click="BtnSave_Click"/>
                <TextBlock x:Name="TxtSaveStatus"
                           VerticalAlignment="Center"
                           FontSize="13" Opacity="0.65"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
