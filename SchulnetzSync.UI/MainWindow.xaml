<Window x:Class="SchulnetzSync.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SchulnetzSync.UI"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Semestria"
        Icon="pack://application:,,,/Resources/semestria.ico"
        MinWidth="700" MinHeight="500"
        Width="960" Height="640"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Flat button for the profile switcher and its menu: no border, a hover fill -->
        <Style x:Key="FlatMenuButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A808080"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A808080"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A808080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>

        <ui:NavigationView x:Name="NavView"
                       PaneDisplayMode="Left"
                       IsSettingsVisible="False"
                       IsPaneToggleButtonVisible="True"
                       IsBackButtonVisible="Collapsed"
                       OpenPaneLength="220"
                       SelectionChanged="NavView_SelectionChanged"
                       ItemInvoked="NavView_ItemInvoked"
                       Loaded="NavView_Loaded">

        <!-- ── Sidebar logo ── -->
        <ui:NavigationView.PaneHeader>
            <StackPanel Margin="10,12,10,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,8">
                    <Image Source="pack://application:,,,/Resources/Semestra_Logo.png"
                           Width="22" Height="22" Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Semestria"
                               FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Static local:AppConstants.VersionShort}"
                               FontSize="11" Opacity="0.45" Margin="8,3,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Profile switcher: one click, like the account picker in Teams -->
                <Button x:Name="BtnProfile" Style="{StaticResource FlatMenuButton}"
                        HorizontalContentAlignment="Stretch"
                        ToolTip="Profil wechseln"
                        AutomationProperties.Name="Profil wechseln"
                        Click="BtnProfile_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="AvatarCircle" Width="30" Height="30" CornerRadius="15"
                                Background="{StaticResource AccentBrush}">
                            <TextBlock x:Name="TxtAvatar" Foreground="White" FontSize="12"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtProfileName" FontSize="14" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtProfileHint" FontSize="11" Opacity="0.55"
                                       Text="Profil wechseln"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="&#xE70D;" FontSize="10" Opacity="0.6"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <Popup x:Name="ProfilePopup"
                       PlacementTarget="{Binding ElementName=BtnProfile}"
                       Placement="Bottom" VerticalOffset="4"
                       StaysOpen="False" AllowsTransparency="True"
                       KeyDown="ProfilePopup_KeyDown">
                    <Border Width="264" CornerRadius="10" Padding="8"
                            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1">
                        <!-- Filled in code: profiles, then add / rename / remove -->
                        <StackPanel x:Name="ProfileMenu"/>
                    </Border>
                </Popup>
            </StackPanel>
        </ui:NavigationView.PaneHeader>

        <!-- ── Navigation items ── -->
        <ui:NavigationView.MenuItems>
            <ui:NavigationViewItem x:Name="NavDashboard"
                                   Tag="Dashboard"
                                   Content="Dashboard">
                <ui:NavigationViewItem.Icon>
                    <ui:SymbolIcon Symbol="Home"/>
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>

            <ui:NavigationViewItem x:Name="NavEvents"
                                   Tag="Events"
                                   Content="Prüfungen &amp; Termine">
                <ui:NavigationViewItem.Icon>
                    <ui:SymbolIcon Symbol="Calendar"/>
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>

            <ui:NavigationViewItem x:Name="NavTasks"
                                   Tag="Tasks"
                                   Content="Aufgaben">
                <ui:NavigationViewItem.Icon>
                    <ui:SymbolIcon Symbol="List"/>
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>

            <ui:NavigationViewItem x:Name="NavGrades"
                                   Tag="Grades"
                                   Content="Noten">
                <ui:NavigationViewItem.Icon>
                    <ui:FontIcon Glyph="&#xE9D2;"/>
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>

            <ui:NavigationViewItem x:Name="NavSettings"
                                   Tag="Settings"
                                   Content="Einstellungen">
                <ui:NavigationViewItem.Icon>
                    <ui:SymbolIcon Symbol="Setting"/>
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
        </ui:NavigationView.MenuItems>

        <ui:NavigationView.FooterMenuItems>
            <!-- Every short tour of the app, to be shown again -->
            <ui:NavigationViewItem x:Name="NavHelp"
                                   Tag="Help"
                                   Content="Hilfe"
                                   ToolTipService.ToolTip="Anleitungen noch einmal ansehen">
                <ui:NavigationViewItem.Icon>
                    <ui:SymbolIcon Symbol="Help"/>
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>

            <!--
                Not a page: this opens the web app in the browser.
                SelectsOnInvoked=False so the current page stays highlighted.
            -->
            <ui:NavigationViewItem x:Name="NavSynapkey"
                                   Tag="Synapkey"
                                   Content="Synapkey"
                                   SelectsOnInvoked="False"
                                   ToolTipService.ToolTip="Synapkey-Dashboard im Browser öffnen">
                <ui:NavigationViewItem.Icon>
                    <!-- Segoe MDL2 "OpenInNewWindow" -->
                    <ui:FontIcon Glyph="&#xE8A7;"/>
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>

            <ui:NavigationViewItem x:Name="NavAbout"
                                   Tag="About"
                                   Content="Über &amp; Rechtliches">
                <ui:NavigationViewItem.Icon>
                    <!-- Segoe MDL2 "Info"; the question mark belongs to «Hilfe» -->
                    <ui:FontIcon Glyph="&#xE946;"/>
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
        </ui:NavigationView.FooterMenuItems>

        <!-- ── Content ── -->
        <Frame x:Name="ContentFrame"
               NavigationUIVisibility="Hidden"/>

        </ui:NavigationView>

        <!-- ══════════════════════════════════════════════════════════════
             LOADING VIEW

             Not a window of its own, just a layer on top of everything else.
             It covers the navigation while the app starts and disappears afterwards.
             ══════════════════════════════════════════════════════════════ -->
        <Border x:Name="LoadingOverlay"
                Background="{DynamicResource ApplicationPageBackgroundThemeBrush}">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        MaxWidth="420">

                <Image Source="pack://application:,,,/Resources/Semestra_Logo.png"
                       Width="72" Height="72"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,18"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <TextBlock Text="Semestria"
                           FontSize="24" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}"/>

                <TextBlock x:Name="TxtLoadingVersion"
                           FontSize="12" Opacity="0.55"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,26"/>

                <!-- States 1 and 3: progress -->
                <StackPanel x:Name="LoadingProgressArea">
                    <ProgressBar x:Name="LoadingBar"
                                 Width="320" Height="4"
                                 Minimum="0" Maximum="1"
                                 HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtLoadingStatus"
                               Text="Wird gestartet…"
                               FontSize="13" Opacity="0.75"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"/>
                </StackPanel>

                <!-- State 2: an update was found -->
                <StackPanel x:Name="UpdatePromptArea" Visibility="Collapsed">
                    <TextBlock x:Name="TxtUpdateHeadline"
                               FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtUpdateBody"
                               FontSize="13" Opacity="0.75"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,22"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button x:Name="BtnUpdateNow"
                                Content="Jetzt aktualisieren"
                                Style="{StaticResource PrimaryButton}"
                                Padding="22,10"
                                Margin="0,0,10,0"
                                Click="BtnUpdateNow_Click"/>
                        <Button x:Name="BtnUpdateLater"
                                Content="Später erinnern"
                                Style="{StaticResource SecondaryButton}"
                                Padding="22,10"
                                Click="BtnUpdateLater_Click"/>
                    </StackPanel>

                    <!-- A way out when a mandatory update refuses to go through -->
                    <StackPanel x:Name="UpdateFailureArea"
                                Visibility="Collapsed"
                                Margin="0,16,0,0">
                        <TextBlock x:Name="TxtUpdateError"
                                   FontSize="12"
                                   Foreground="{StaticResource DangerBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <Button x:Name="BtnUpdateRetry"
                                    Content="Erneut versuchen"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="18,8"
                                    Margin="0,0,10,0"
                                    Click="BtnUpdateRetry_Click"/>
                            <Button x:Name="BtnQuit"
                                    Content="Semestria beenden"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="18,8"
                                    Click="BtnQuit_Click"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- State 4: back after the restart -->
                <StackPanel x:Name="UpdateDoneArea" Visibility="Collapsed">
                    <TextBlock Text="✓" FontSize="34"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource SuccessBrush}"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtUpdateDone"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Guided tours of the pages, above everything (see Controls/TourOverlay) -->
        <Canvas x:Name="TourLayer" Visibility="Collapsed"/>
    </Grid>
</Window>
