<Page x:Class="SchulnetzSync.UI.Pages.EventsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      Title="Prüfungen &amp; Termine">

    <Page.Resources>
        <!-- Dag-Button-Stil im Kalender -->
        <Style x:Key="DayButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal"/>
                                    <VisualState Name="MouseOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames
                                                Storyboard.TargetName="Root"
                                                Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                    <DiscreteObjectKeyFrame.Value>
                                                        <SolidColorBrush Color="{StaticResource AccentColor}" Opacity="0.15"/>
                                                    </DiscreteObjectKeyFrame.Value>
                                                </DiscreteObjectKeyFrame>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Outlook-Sync-Hinweis: blaue Linie -->
        <Style x:Key="OutlookHint" TargetType="Border" BasedOn="{StaticResource InfoBox}">
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>
    </Page.Resources>

    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header + Filter -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Prüfungen &amp; Termine"
                           Style="{StaticResource TitleText}" Margin="0,0,0,4"/>
                <TextBlock x:Name="TxtSubtitle"
                           Text="In-App Kalender — immer verfügbar, unabhängig von Outlook."
                           Style="{StaticResource BodyText}"/>
            </StackPanel>

            <!-- Filter-Chips -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="BtnFilterAll"
                        Content="Alle"
                        Style="{StaticResource PrimaryButton}"
                        Padding="14,7" FontSize="12" Margin="0,0,6,0"
                        Click="BtnFilter_Click" Tag="All"/>
                <Button x:Name="BtnFilterPruefung"
                        Content="Prüfungen"
                        Style="{StaticResource SecondaryButton}"
                        Padding="14,7" FontSize="12" Margin="0,0,6,0"
                        Click="BtnFilter_Click" Tag="Pruefung"/>
                <Button x:Name="BtnFilterTermin"
                        Content="Termine"
                        Style="{StaticResource SecondaryButton}"
                        Padding="14,7" FontSize="12"
                        Click="BtnFilter_Click" Tag="Termin"/>
            </StackPanel>
        </Grid>

        <!-- Kein-Events-Hinweis (wenn noch kein Sync) -->
        <Border x:Name="NoDataHint" Grid.Row="2"
                Style="{StaticResource Card}" Visibility="Collapsed"
                VerticalAlignment="Top">
            <StackPanel HorizontalAlignment="Center" Margin="0,32">
                <TextBlock Text="📅" FontSize="52" HorizontalAlignment="Center"/>
                <TextBlock Text="Noch keine Einträge"
                           FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,14,0,6"/>
                <TextBlock Text="Gehe zum Dashboard und starte eine Synchronisation."
                           Style="{StaticResource BodyText}"
                           HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock Text="Der Kalender wird auch ohne Outlook-Anbindung befüllt."
                           Style="{StaticResource NoteText}"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Haupt-Layout: Kalender links, Detail rechts -->
        <Grid x:Name="MainLayout" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="272"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Linke Spalte: Mini-Kalender ── -->
            <Border Grid.Column="0" Style="{StaticResource Card}"
                    Margin="0" Padding="16">

                <StackPanel>
                    <!-- Monats-Navigation -->
                    <Grid Margin="0,0,0,14">
                        <TextBlock x:Name="TxtMonthYear"
                                   FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnPrevMonth"
                                    Content="‹" FontSize="16"
                                    Style="{StaticResource DayButton}"
                                    Width="28" Height="28"
                                    Click="BtnPrevMonth_Click"/>
                            <Button x:Name="BtnNextMonth"
                                    Content="›" FontSize="16"
                                    Style="{StaticResource DayButton}"
                                    Width="28" Height="28" Margin="4,0,0,0"
                                    Click="BtnNextMonth_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Wochentag-Köpfe -->
                    <Grid x:Name="DayHeadersGrid" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Mo" FontSize="11" FontWeight="SemiBold"
                                   Opacity="0.4" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Di" FontSize="11" FontWeight="SemiBold"
                                   Opacity="0.4" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="Mi" FontSize="11" FontWeight="SemiBold"
                                   Opacity="0.4" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="Do" FontSize="11" FontWeight="SemiBold"
                                   Opacity="0.4" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="Fr" FontSize="11" FontWeight="SemiBold"
                                   Opacity="0.4" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="Sa" FontSize="11" FontWeight="SemiBold"
                                   Opacity="0.35" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="6" Text="So" FontSize="11" FontWeight="SemiBold"
                                   Opacity="0.35" HorizontalAlignment="Center"/>
                    </Grid>

                    <!-- Kalender-Grid (6 Zeilen × 7 Spalten — Tage via Code befüllt) -->
                    <Grid x:Name="CalendarGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                    </Grid>

                    <!-- Legende -->
                    <StackPanel Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <Ellipse Width="8" Height="8" Fill="#EF4444"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Prüfung" FontSize="11" Opacity="0.65"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#3B82F6"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Termin" FontSize="11" Opacity="0.65"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Outlook-Sync Hinweis -->
                    <Border Style="{StaticResource OutlookHint}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Outlook-Sync" FontWeight="SemiBold"
                                       FontSize="12" Margin="0,0,0,4"/>
                            <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap">
                                Optional: Einträge auch in Outlook schreiben. In den Einstellungen konfigurieren.
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ── Rechte Spalte: Detail / Kommende ── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Ausgewählter Tag -->
                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock x:Name="TxtSelectedDay"
                               FontSize="17" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <TextBlock x:Name="TxtSelectedDaySub"
                               Style="{StaticResource BodyText}"/>
                </StackPanel>

                <!-- Events für gewählten Tag / Upcoming -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="EventsPanel"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
