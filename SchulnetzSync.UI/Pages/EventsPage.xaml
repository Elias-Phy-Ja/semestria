<Page x:Class="SchulnetzSync.UI.Pages.EventsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      Title="Prüfungen &amp; Termine">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Toolbar -->
            <RowDefinition Height="*"/>     <!-- Kalender + Detail -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════════
             TOOLBAR
             ══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="20,14,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Titel -->
            <TextBlock Grid.Column="0"
                       Text="Prüfungen &amp; Termine"
                       Style="{StaticResource TitleText}"
                       VerticalAlignment="Center"/>

            <!-- Monats-Navigation (zentriert) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="BtnPrevMonth" Content="‹" FontSize="20"
                        Style="{StaticResource SecondaryButton}" Padding="10,4"
                        Click="BtnPrevMonth_Click"/>
                <TextBlock x:Name="TxtMonthYear"
                           FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="16,0"
                           MinWidth="175" TextAlignment="Center"/>
                <Button x:Name="BtnNextMonth" Content="›" FontSize="20"
                        Style="{StaticResource SecondaryButton}" Padding="10,4"
                        Click="BtnNextMonth_Click"/>
                <Button x:Name="BtnToday" Content="Heute"
                        Style="{StaticResource SecondaryButton}"
                        Padding="12,5" Margin="10,0,0,0"
                        Click="BtnToday_Click"/>
            </StackPanel>

            <!-- Filter-Chips (rechts) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnFilterAll" Content="Alle"
                        Style="{StaticResource PrimaryButton}"
                        Padding="12,5" FontSize="12" Margin="0,0,6,0"
                        Click="BtnFilter_Click" Tag="All"/>
                <Button x:Name="BtnFilterPruefung" Content="Prüfungen"
                        Style="{StaticResource SecondaryButton}"
                        Padding="12,5" FontSize="12" Margin="0,0,6,0"
                        Click="BtnFilter_Click" Tag="Pruefung"/>
                <Button x:Name="BtnFilterTermin" Content="Termine"
                        Style="{StaticResource SecondaryButton}"
                        Padding="12,5" FontSize="12"
                        Click="BtnFilter_Click" Tag="Termin"/>
            </StackPanel>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════
             NO-DATA HINT (sichtbar wenn noch kein Feed geladen)
             ══════════════════════════════════════════════════════════════ -->
        <Border x:Name="NoDataHint" Grid.Row="1" Visibility="Collapsed"
                Style="{StaticResource Card}" Margin="20"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                MinWidth="400">
            <StackPanel Margin="48,40">
                <TextBlock Text="📅" FontSize="64" HorizontalAlignment="Center"/>
                <TextBlock Text="Noch keine Einträge"
                           FontSize="20" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,16,0,8"/>
                <TextBlock Text="Gehe zum Dashboard und klicke «Feed laden»."
                           Style="{StaticResource BodyText}"
                           HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock Text="Kein Microsoft-Konto nötig."
                           Style="{StaticResource NoteText}"
                           HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════
             HAUPT-LAYOUT: Kalender (links) + Detail-Panel (rechts)
             ══════════════════════════════════════════════════════════════ -->
        <Grid x:Name="MainLayout" Grid.Row="1" Margin="20,10,20,20" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <!-- Detail-Panel: 0 = versteckt, 330 = sichtbar (per Code gesetzt) -->
                <ColumnDefinition x:Name="DetailColumnDef" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- ── Kalender-Bereich ── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="26"/>  <!-- Wochentag-Köpfe -->
                    <RowDefinition Height="*"/>   <!-- Kalender-Zellen -->
                </Grid.RowDefinitions>

                <!-- Wochentag-Köpfe -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="0,0,0,1" Padding="0,4,0,4">
                        <TextBlock Text="Mo" FontSize="11" FontWeight="SemiBold"
                                   Opacity="0.50" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="0,0,0,1" Padding="0,4,0,4">
                        <TextBlock Text="Di" FontSize="11" FontWeight="SemiBold"
                                   Opacity="0.50" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="2" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="0,0,0,1" Padding="0,4,0,4">
                        <TextBlock Text="Mi" FontSize="11" FontWeight="SemiBold"
                                   Opacity="0.50" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="3" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="0,0,0,1" Padding="0,4,0,4">
                        <TextBlock Text="Do" FontSize="11" FontWeight="SemiBold"
                                   Opacity="0.50" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="4" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="0,0,0,1" Padding="0,4,0,4">
                        <TextBlock Text="Fr" FontSize="11" FontWeight="SemiBold"
                                   Opacity="0.50" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="5" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="0,0,0,1" Padding="0,4,0,4">
                        <TextBlock Text="Sa" FontSize="11" FontWeight="SemiBold"
                                   Opacity="0.35" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="6" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="0,0,0,1" Padding="0,4,0,4">
                        <TextBlock Text="So" FontSize="11" FontWeight="SemiBold"
                                   Opacity="0.35" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- Kalender-Zellen (6×7, per Code befüllt) -->
                <Grid Grid.Row="1" x:Name="CalendarGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                </Grid>
            </Grid>

            <!-- ── Detail-Panel (rechts, standardmässig versteckt) ── -->
            <Border x:Name="DetailPanel"
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    Visibility="Collapsed"
                    CornerRadius="12"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Header mit Schliessen-Knopf -->
                        <RowDefinition Height="*"/>     <!-- Inhalt (scrollbar) -->
                        <RowDefinition Height="Auto"/>  <!-- Aktions-Buttons -->
                    </Grid.RowDefinitions>

                    <!-- Panel-Header -->
                    <Grid Grid.Row="0" Margin="16,12,16,12">
                        <TextBlock x:Name="TxtDetailBadge"
                                   FontSize="12" FontWeight="SemiBold"
                                   Opacity="0.45" VerticalAlignment="Center"/>
                        <Button x:Name="BtnCloseDetail" Content="✕"
                                HorizontalAlignment="Right"
                                Style="{StaticResource SecondaryButton}"
                                Padding="8,3" FontSize="11"
                                Click="BtnCloseDetail_Click"/>
                    </Grid>
                    <Separator Grid.Row="0" VerticalAlignment="Bottom"
                               Margin="0" Style="{StaticResource Divider}"/>

                    <!-- Event-Details (scrollbar) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DetailContent" Margin="16,14,16,0"/>
                    </ScrollViewer>

                    <!-- Aktions-Buttons -->
                    <Border Grid.Row="2"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="16,12">
                        <StackPanel>
                            <Button x:Name="BtnDeleteFromApp"
                                    Content="🚫  Aus App ausblenden"
                                    Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,0,0,8"
                                    Click="BtnDeleteFromApp_Click"/>
                            <TextBlock FontSize="10" Opacity="0.50"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Text="Bleibt im Schulnetz-Feed. Wird nur hier ausgeblendet."/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
