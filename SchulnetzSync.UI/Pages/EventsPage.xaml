<Page x:Class="SchulnetzSync.UI.Pages.EventsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      Title="Prüfungen &amp; Termine">

    <Page.Resources>

        <!-- Halbtransparentes Grau wirkt im hellen wie im dunklen Theme -->
        <SolidColorBrush x:Key="HoverOverlay"   Color="#1A808080"/>
        <SolidColorBrush x:Key="PressedOverlay" Color="#2A808080"/>
        <SolidColorBrush x:Key="SubtleFill"     Color="#14808080"/>
        <SolidColorBrush x:Key="SubtleBorder"   Color="#26808080"/>
        <SolidColorBrush x:Key="AccentTint"     Color="{StaticResource AccentColor}" Opacity="0.18"/>

        <!-- Kleiner Knopf mit dezentem Rahmen, beim Überfahren eine Fläche -->
        <Style x:Key="ToolbarGhost" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverOverlay}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedOverlay}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Breiterer Textknopf, z. B. «Heute» -->
        <Style x:Key="ToolbarOutline" TargetType="Button" BasedOn="{StaticResource ToolbarGhost}">
            <Setter Property="Padding" Value="14,0"/>
        </Style>

        <!-- Gefüllter Hauptknopf der Leiste -->
        <Style x:Key="ToolbarAccent" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0,14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="8"/>
                            <Border x:Name="Overlay" Background="Transparent" CornerRadius="8"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="#1FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="#26000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segment im Monat/Woche-Umschalter -->
        <Style x:Key="SegmentRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                Padding="14,0" MinWidth="72">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverOverlay}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter-Chip: gewählt = Akzent-Tönung mit Akzent-Rahmen -->
        <Style x:Key="FilterChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="13"
                                BorderThickness="1" BorderBrush="{StaticResource SubtleBorder}"
                                Padding="12,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverOverlay}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentTint}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Toolbar -->
            <RowDefinition Height="*"/>     <!-- Kalender + Panel -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════════
             TOOLBAR  (2 Zeilen: Hauptleiste + kompakte Filter-Leiste)
             ══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="20,10,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- Hauptleiste -->
                <RowDefinition Height="Auto"/>   <!-- Filter-Leiste -->
            </Grid.RowDefinitions>

            <!-- ── Hauptleiste ───────────────────────────────────────────── -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>  <!-- Titel -->
                    <ColumnDefinition Width="*"/>     <!-- Navigation (zentriert) -->
                    <ColumnDefinition Width="Auto"/>  <!-- Ansicht + Aktionen -->
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Prüfungen &amp; Termine"
                           Style="{StaticResource TitleText}"
                           VerticalAlignment="Center"/>

                <!-- Navigation: ‹ Monat › und «Heute» -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="BtnPrevMonth" Style="{StaticResource ToolbarGhost}"
                            ToolTip="Zurück" Click="BtnPrevMonth_Click">
                        <TextBlock Text="&#xE76B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"/>
                    </Button>
                    <TextBlock x:Name="TxtMonthYear"
                               FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                               VerticalAlignment="Center" Margin="8,0"
                               MinWidth="190" TextAlignment="Center"/>
                    <Button x:Name="BtnNextMonth" Style="{StaticResource ToolbarGhost}"
                            ToolTip="Weiter" Click="BtnNextMonth_Click">
                        <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"/>
                    </Button>
                    <Button x:Name="BtnToday" Content="Heute"
                            Style="{StaticResource ToolbarOutline}"
                            Margin="10,0,0,0" Click="BtnToday_Click"/>
                </StackPanel>

                <!-- Rechts: Ansicht, Einstellungen, Neuer Eintrag -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource SubtleFill}"
                            BorderBrush="{StaticResource SubtleBorder}" BorderThickness="1"
                            CornerRadius="9" Padding="3" Height="34">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="BtnViewMonth" Content="Monat" GroupName="CalView"
                                         Style="{StaticResource SegmentRadio}"
                                         Checked="BtnViewMonth_Click"/>
                            <RadioButton x:Name="BtnViewWeek" Content="Woche" GroupName="CalView"
                                         Style="{StaticResource SegmentRadio}" IsChecked="True"
                                         Checked="BtnViewWeek_Click"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnCalSettings" Style="{StaticResource ToolbarGhost}"
                            Margin="10,0,4,0" ToolTip="Kalender-Einstellungen"
                            Click="BtnCalSettings_Click">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"/>
                    </Button>

                    <Button x:Name="BtnAddEvent" Style="{StaticResource ToolbarAccent}"
                            ToolTip="Eigenen Eintrag hinzufügen"
                            Click="BtnAddEvent_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="12" VerticalAlignment="Center" Margin="0,1,8,0"/>
                            <TextBlock Text="Neu" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ── Filter-Leiste ─────────────────────────────────────────── -->
            <StackPanel Grid.Row="1" Orientation="Horizontal"
                        Margin="0,10,0,0" VerticalAlignment="Center">
                <RadioButton x:Name="BtnFilterAll" Content="Alle" GroupName="CalFilter"
                             Style="{StaticResource FilterChip}" IsChecked="True"
                             Checked="BtnFilter_Click" Tag="All"/>
                <RadioButton x:Name="BtnFilterPruefung" Content="Prüfungen" GroupName="CalFilter"
                             Style="{StaticResource FilterChip}"
                             Checked="BtnFilter_Click" Tag="Pruefung"/>
                <RadioButton x:Name="BtnFilterTermin" Content="Termine" GroupName="CalFilter"
                             Style="{StaticResource FilterChip}"
                             Checked="BtnFilter_Click" Tag="Termin"/>
                <RadioButton x:Name="BtnFilterLektion" Content="Stunden" GroupName="CalFilter"
                             Style="{StaticResource FilterChip}"
                             Checked="BtnFilter_Click" Tag="Lektion"/>
            </StackPanel>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════
             NO-DATA
             ══════════════════════════════════════════════════════════════ -->
        <Border x:Name="NoDataHint" Grid.Row="1" Visibility="Collapsed"
                Style="{StaticResource Card}" Margin="20"
                VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="380">
            <StackPanel Margin="48,40">
                <TextBlock Text="📅" FontSize="64" HorizontalAlignment="Center"/>
                <TextBlock Text="Noch keine Einträge"
                           FontSize="20" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,16,0,8"/>
                <TextBlock Text="Gehe zum Dashboard und klicke «Feed laden»."
                           Style="{StaticResource BodyText}"
                           HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock Text="Kein Microsoft-Konto nötig."
                           Style="{StaticResource NoteText}"
                           HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════
             HAUPT-LAYOUT: Kalender + rechtes Panel
             ══════════════════════════════════════════════════════════════ -->
        <Grid x:Name="MainLayout" Grid.Row="1" Margin="20,8,20,20" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="DetailColumnDef" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- ── Kalender-Bereich ── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Wochentag-Köpfe (Monatsansicht) -->
                <Grid Grid.Row="0" x:Name="MonthDayHeaders">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="Mo" FontSize="11" FontWeight="SemiBold" Opacity="0.50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="Di" FontSize="11" FontWeight="SemiBold" Opacity="0.50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="2" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="Mi" FontSize="11" FontWeight="SemiBold" Opacity="0.50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="3" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="Do" FontSize="11" FontWeight="SemiBold" Opacity="0.50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="4" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="Fr" FontSize="11" FontWeight="SemiBold" Opacity="0.50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="5" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="Sa" FontSize="11" FontWeight="SemiBold" Opacity="0.35" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="6" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="So" FontSize="11" FontWeight="SemiBold" Opacity="0.35" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- Monatsansicht: 6×7 Zellen -->
                <Grid Grid.Row="1" x:Name="CalendarGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                </Grid>

                <!-- Wochenansicht (Struktur wird vollständig in Code aufgebaut) -->
                <Grid Grid.Row="0" Grid.RowSpan="2" x:Name="WeekGrid" Visibility="Collapsed"/>
            </Grid>

            <!-- ── Rechtes Panel (Detail / Einstellungen / Neuer Eintrag) ── -->
            <Border x:Name="DetailPanel"
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    Visibility="Collapsed"
                    CornerRadius="12"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Header -->
                        <RowDefinition Height="*"/>     <!-- Scrollbarer Inhalt -->
                        <RowDefinition Height="Auto"/>  <!-- Footer mit Aktionen -->
                    </Grid.RowDefinitions>

                    <!-- Panel-Header -->
                    <Grid Grid.Row="0" Margin="16,12,16,12">
                        <TextBlock x:Name="TxtPanelTitle"
                                   FontSize="11" FontWeight="Bold"
                                   Opacity="0.60" VerticalAlignment="Center"/>
                        <Button x:Name="BtnClosePanel" Content="✕"
                                HorizontalAlignment="Right"
                                Style="{StaticResource SecondaryButton}"
                                Padding="8,3" FontSize="11"
                                Click="BtnClosePanel_Click"/>
                    </Grid>
                    <Separator Grid.Row="0" VerticalAlignment="Bottom"
                               Margin="0" Style="{StaticResource Divider}"/>

                    <!-- Scrollbarer Inhalt -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,14,16,8">
                            <!-- Detail-Inhalt (per Code befüllt) -->
                            <StackPanel x:Name="DetailContent"/>

                            <!-- Einstellungs-Inhalt (per Code befüllt) -->
                            <StackPanel x:Name="SettingsContent" Visibility="Collapsed"/>

                            <!-- Neuer-Eintrag-Formular (statisch in XAML) -->
                            <StackPanel x:Name="AddEventSection" Visibility="Collapsed">

                                <TextBlock Text="Titel *"
                                           FontWeight="SemiBold" FontSize="13"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="TxtNewTitle"
                                         Height="34"
                                         FontSize="13"
                                         Margin="0,0,0,14"/>

                                <TextBlock Text="Datum *"
                                           FontWeight="SemiBold" FontSize="13"
                                           Margin="0,0,0,5"/>
                                <DatePicker x:Name="DpNewDate"
                                            Height="34"
                                            FontSize="13"
                                            Margin="0,0,0,14"/>

                                <CheckBox x:Name="ChkNewAllDay"
                                          Content="Ganztägig"
                                          FontSize="13"
                                          Margin="0,0,0,12"
                                          Checked="ChkNewAllDay_Changed"
                                          Unchecked="ChkNewAllDay_Changed"/>

                                <StackPanel x:Name="TimePickers" Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Von"
                                                       FontWeight="SemiBold" FontSize="13"
                                                       Margin="0,0,0,5"/>
                                            <TextBox x:Name="TxtStartTime"
                                                     Width="75" Height="34" FontSize="13"
                                                     Text="08:00"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Bis"
                                                       FontWeight="SemiBold" FontSize="13"
                                                       Margin="0,0,0,5"/>
                                            <TextBox x:Name="TxtEndTime"
                                                     Width="75" Height="34" FontSize="13"
                                                     Text="09:00"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="Typ"
                                           FontWeight="SemiBold" FontSize="13"
                                           Margin="0,0,0,5"/>
                                <ComboBox x:Name="CmbNewType"
                                          Height="34" FontSize="13"
                                          Margin="0,0,0,14">
                                    <ComboBoxItem Content="Prüfung" Tag="Pruefung" IsSelected="True"/>
                                    <ComboBoxItem Content="Termin"  Tag="Termin"/>
                                </ComboBox>

                                <TextBlock Text="Ort (optional)"
                                           FontWeight="SemiBold" FontSize="13"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="TxtNewLocation"
                                         Height="34" FontSize="13"/>

                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Panel-Footer -->
                    <Border Grid.Row="2"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="0,1,0,0" Padding="16,12">
                        <Grid>
                            <!-- Detail-Footer: Ausblenden -->
                            <StackPanel x:Name="DetailFooter">
                                <Button x:Name="BtnDeleteFromApp"
                                        Content="🚫  Aus App ausblenden"
                                        Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,6"
                                        Click="BtnDeleteFromApp_Click"/>
                                <TextBlock FontSize="10" Opacity="0.45"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           Text="Bleibt im Schulnetz-Feed. Hier dauerhaft ausgeblendet."/>
                            </StackPanel>

                            <!-- AddEvent-Footer: Speichern -->
                            <Button x:Name="BtnSaveManualEvent"
                                    Visibility="Collapsed"
                                    Content="✓  Eintrag hinzufügen"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Stretch"
                                    Click="BtnSaveManualEvent_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
