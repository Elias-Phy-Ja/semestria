<Window x:Class="SchulnetzSync.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SchulnetzSync.UI"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Semestria"
        Icon="pack://application:,,,/Resources/semestria.ico"
        MinWidth="700" MinHeight="500"
        Width="960" Height="640"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <ui:NavigationView x:Name="NavView"
                       PaneDisplayMode="Left"
                       IsSettingsVisible="False"
                       IsPaneToggleButtonVisible="True"
                       IsBackButtonVisible="Collapsed"
                       OpenPaneLength="220"
                       SelectionChanged="NavView_SelectionChanged"
                       ItemInvoked="NavView_ItemInvoked"
                       Loaded="NavView_Loaded">

        <!-- ── Sidebar logo ── -->
        <ui:NavigationView.PaneHeader>
            <StackPanel Margin="16,12,16,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,2">
                    <Image Source="pack://application:,,,/Resources/Semestra_Logo.png"
                           Width="22" Height="22" Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Semestria"
                               FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{x:Static local:AppConstants.VersionShort}"
                           FontSize="11" Opacity="0.45"/>
            </StackPanel>
        </ui:NavigationView.PaneHeader>

        <!-- ── Navigation items ── -->
        <ui:NavigationView.MenuItems>
            <ui:NavigationViewItem x:Name="NavDashboard"
                                   Tag="Dashboard"
                                   Content="Dashboard">
                <ui:NavigationViewItem.Icon>
                    <ui:SymbolIcon Symbol="Home"/>
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>

            <ui:NavigationViewItem x:Name="NavEvents"
                                   Tag="Events"
                                   Content="Prüfungen &amp; Termine">
                <ui:NavigationViewItem.Icon>
                    <ui:SymbolIcon Symbol="Calendar"/>
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>

            <ui:NavigationViewItem x:Name="NavTasks"
                                   Tag="Tasks"
                                   Content="Aufgaben">
                <ui:NavigationViewItem.Icon>
                    <ui:SymbolIcon Symbol="List"/>
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>

            <ui:NavigationViewItem x:Name="NavSettings"
                                   Tag="Settings"
                                   Content="Einstellungen">
                <ui:NavigationViewItem.Icon>
                    <ui:SymbolIcon Symbol="Setting"/>
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
        </ui:NavigationView.MenuItems>

        <ui:NavigationView.FooterMenuItems>
            <!--
                Not a page: this opens the web app in the browser.
                SelectsOnInvoked=False so the current page stays highlighted.
            -->
            <ui:NavigationViewItem x:Name="NavSynapkey"
                                   Tag="Synapkey"
                                   Content="Synapkey"
                                   SelectsOnInvoked="False"
                                   ToolTipService.ToolTip="Synapkey-Dashboard im Browser öffnen">
                <ui:NavigationViewItem.Icon>
                    <!-- Segoe MDL2 "OpenInNewWindow" -->
                    <ui:FontIcon Glyph="&#xE8A7;"/>
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>

            <ui:NavigationViewItem x:Name="NavAbout"
                                   Tag="About"
                                   Content="Über &amp; Rechtliches">
                <ui:NavigationViewItem.Icon>
                    <ui:SymbolIcon Symbol="Help"/>
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
        </ui:NavigationView.FooterMenuItems>

        <!-- ── Content ── -->
        <Frame x:Name="ContentFrame"
               NavigationUIVisibility="Hidden"/>

        </ui:NavigationView>

        <!-- ══════════════════════════════════════════════════════════════
             LOADING VIEW

             Not a window of its own, just a layer on top of everything else.
             It covers the navigation while the app starts and disappears afterwards.
             ══════════════════════════════════════════════════════════════ -->
        <Border x:Name="LoadingOverlay"
                Background="{DynamicResource ApplicationPageBackgroundThemeBrush}">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        MaxWidth="420">

                <Image Source="pack://application:,,,/Resources/Semestra_Logo.png"
                       Width="72" Height="72"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,18"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <TextBlock Text="Semestria"
                           FontSize="24" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}"/>

                <TextBlock x:Name="TxtLoadingVersion"
                           FontSize="12" Opacity="0.55"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,26"/>

                <!-- States 1 and 3: progress -->
                <StackPanel x:Name="LoadingProgressArea">
                    <ProgressBar x:Name="LoadingBar"
                                 Width="320" Height="4"
                                 Minimum="0" Maximum="1"
                                 HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtLoadingStatus"
                               Text="Wird gestartet…"
                               FontSize="13" Opacity="0.75"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"/>
                </StackPanel>

                <!-- State 2: an update was found -->
                <StackPanel x:Name="UpdatePromptArea" Visibility="Collapsed">
                    <TextBlock x:Name="TxtUpdateHeadline"
                               FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtUpdateBody"
                               FontSize="13" Opacity="0.75"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,22"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button x:Name="BtnUpdateNow"
                                Content="Jetzt aktualisieren"
                                Style="{StaticResource PrimaryButton}"
                                Padding="22,10"
                                Margin="0,0,10,0"
                                Click="BtnUpdateNow_Click"/>
                        <Button x:Name="BtnUpdateLater"
                                Content="Später erinnern"
                                Style="{StaticResource SecondaryButton}"
                                Padding="22,10"
                                Click="BtnUpdateLater_Click"/>
                    </StackPanel>

                    <!-- A way out when a mandatory update refuses to go through -->
                    <StackPanel x:Name="UpdateFailureArea"
                                Visibility="Collapsed"
                                Margin="0,16,0,0">
                        <TextBlock x:Name="TxtUpdateError"
                                   FontSize="12"
                                   Foreground="{StaticResource DangerBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <Button x:Name="BtnUpdateRetry"
                                    Content="Erneut versuchen"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="18,8"
                                    Margin="0,0,10,0"
                                    Click="BtnUpdateRetry_Click"/>
                            <Button x:Name="BtnQuit"
                                    Content="Semestria beenden"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="18,8"
                                    Click="BtnQuit_Click"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- State 4: back after the restart -->
                <StackPanel x:Name="UpdateDoneArea" Visibility="Collapsed">
                    <TextBlock Text="✓" FontSize="34"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource SuccessBrush}"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtUpdateDone"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
