<Page x:Class="SchulnetzSync.UI.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      Title="Dashboard">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32">

            <!-- Header -->
            <TextBlock Text="Dashboard"
                       Style="{StaticResource TitleText}"
                       Margin="0,0,0,4"/>
            <TextBlock x:Name="TxtHeaderSub"
                       Text="Alles im Blick."
                       Style="{StaticResource BodyText}"
                       Margin="0,0,0,24"/>

            <!-- Hinweis: Feed-URL fehlt -->
            <Border x:Name="SetupHint" Visibility="Collapsed"
                    Style="{StaticResource WarningBox}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Einrichtung nicht vollständig"
                                   FontWeight="SemiBold" FontSize="14"
                                   Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource BodyText}"
                                   Text="Trage unter Einstellungen deine Schulnetz Feed-URL ein."/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Einstellungen"
                            Style="{StaticResource SecondaryButton}"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0"
                            Click="BtnGoSettings_Click"/>
                </Grid>
            </Border>

            <!-- STATUS-KARTE -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <Ellipse x:Name="StatusDot" Width="10" Height="10"
                                 Fill="{StaticResource WarningBrush}"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtStatusLabel"
                                   Text="Noch kein Sync"
                                   Style="{StaticResource HeadlineText}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,0,2">
                        <TextBlock x:Name="TxtLastFeed"
                                   Text="Feed: noch nie geladen"
                                   Style="{StaticResource BodyText}"/>
                        <TextBlock x:Name="TxtLastRun"
                                   Text="Outlook: noch nie synchronisiert"
                                   Style="{StaticResource BodyText}"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtLastResult"
                               Grid.Row="2" Text=""
                               Style="{StaticResource NoteText}" Margin="0,2,0,16"/>

                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                        <!-- Outlook-Sync -->
                        <Button x:Name="BtnSync"
                                Content="Mit Outlook synchronisieren"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,12,0"
                                Click="BtnSync_Click"/>
                        <!-- Feed laden (kein Outlook nötig) -->
                        <Button x:Name="BtnDryRun"
                                Content="Feed laden"
                                Style="{StaticResource SecondaryButton}"
                                ToolTip="Liest den Schulnetz-Feed und aktualisiert den In-App-Kalender. Kein Microsoft-Konto nötig."
                                Click="BtnDryRun_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Grid.RowSpan="4"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="16,0,0,0">
                        <ui:ProgressRing x:Name="SyncRing"
                                         IsActive="False" Width="44" Height="44"
                                         HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtBusyHint"
                                   Text="" Visibility="Collapsed"
                                   Style="{StaticResource NoteText}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   MaxWidth="120"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- PROTOKOLL -->
            <Border Style="{StaticResource Card}" MinHeight="80">
                <StackPanel>
                    <TextBlock Text="PROTOKOLL" Style="{StaticResource SectionLabel}"
                               Margin="0,0,0,8"/>
                    <ScrollViewer x:Name="LogScroll" MaxHeight="160"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TxtLog"
                                   FontFamily="Consolas" FontSize="12"
                                   TextWrapping="Wrap"
                                   Text="Bereit. «Feed laden» für In-App-Kalender, «Mit Outlook synchronisieren» für Outlook."/>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- STATISTIKEN -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Prüfungen -->
                <Border Grid.Column="0" Style="{StaticResource CardPruefung}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="PRÜFUNGEN" Style="{StaticResource LabelText}"/>
                        <TextBlock x:Name="TxtStatPruefung"
                                   Text="·" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource PruefungBrush}"/>
                        <TextBlock Text="im Feed"
                                   Style="{StaticResource BodyText}"/>
                    </StackPanel>
                </Border>

                <!-- Termine -->
                <Border Grid.Column="2" Style="{StaticResource CardTermin}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="TERMINE" Style="{StaticResource LabelText}"/>
                        <TextBlock x:Name="TxtStatTermin"
                                   Text="·" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource TerminBrush}"/>
                        <TextBlock Text="im Feed"
                                   Style="{StaticResource BodyText}"/>
                    </StackPanel>
                </Border>

                <!-- Status -->
                <Border Grid.Column="4" Style="{StaticResource Card}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="STATUS" Style="{StaticResource LabelText}"/>
                        <TextBlock x:Name="TxtStatStatus"
                                   Text="⏳" FontSize="20" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtStatDetail"
                                   Text="Noch kein Lauf"
                                   Style="{StaticResource BodyText}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- NÄCHSTE 7 TAGE -->
            <Border x:Name="UpcomingCard" Style="{StaticResource Card}"
                    Visibility="Collapsed" Margin="0,16,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtUpcomingTitle"
                                   Grid.Column="0"
                                   Text="NÄCHSTE 7 TAGE"
                                   Style="{StaticResource SectionLabel}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="Kalender öffnen"
                                Style="{StaticResource SecondaryButton}"
                                Click="BtnGoEvents_Click"/>
                    </Grid>

                    <TextBlock x:Name="TxtUpcomingEmpty"
                               Text=""
                               Style="{StaticResource BodyText}"
                               Visibility="Collapsed"/>

                    <StackPanel x:Name="UpcomingList"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
