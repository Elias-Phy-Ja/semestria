<Page x:Class="SchulnetzSync.UI.Pages.GradesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Noten">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,28">

            <!-- Header -->
            <TextBlock Text="Noten" FontSize="26" FontWeight="Bold"/>
            <TextBlock x:Name="TxtSummary" FontSize="13" Opacity="0.65" Margin="0,2,0,20"/>

            <!-- Promotion check against the chosen rule, filled in code -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel x:Name="PromotionCard"/>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- One tile per subject, filled in code -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="FÄCHER" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                    <StackPanel x:Name="SubjectList"/>
                </StackPanel>

                <!-- Subject detail, grade form, target calculator or rule editor -->
                <StackPanel x:Name="RightPane" Grid.Column="2"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
