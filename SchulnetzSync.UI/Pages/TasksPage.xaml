<Page x:Class="SchulnetzSync.UI.Pages.TasksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      Title="Aufgaben">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ Listen-Leiste ══ -->
        <Border Grid.Column="0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="16,28,12,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="LISTEN"
                           Style="{StaticResource SectionLabel}"
                           Margin="4,0,0,10"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ListRail"/>
                </ScrollViewer>

                <StackPanel Grid.Row="2">
                    <Button x:Name="BtnNewList"
                            Content="+  Neue Liste"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,7"
                            Margin="0,8,0,0"
                            Click="BtnNewList_Click"/>

                    <StackPanel x:Name="NewListBox" Visibility="Collapsed" Margin="0,8,0,0">
                        <TextBox x:Name="TxtNewList" Height="34" FontSize="13"
                                 ui:ControlHelper.PlaceholderText="Name der Liste"
                                 KeyDown="TxtNewList_KeyDown"/>
                        <ContentControl x:Name="ListSuggestions" Margin="0,8,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Inhalt ══ -->
        <Grid Grid.Column="1" Margin="28,28,32,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Kopf -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TxtPageTitle"
                               Text="Alle Aufgaben"
                               Style="{StaticResource TitleText}"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtSummary"
                               Text="Hausaufgaben und To-dos."
                               Style="{StaticResource BodyText}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <Button x:Name="BtnDeleteList"
                            Content="Liste löschen"
                            Style="{StaticResource SecondaryButton}"
                            Visibility="Collapsed"
                            Margin="0,0,10,0"
                            Click="BtnDeleteList_Click"/>
                    <Button x:Name="BtnNew"
                            Content="+  Neue Aufgabe"
                            Style="{StaticResource PrimaryButton}"
                            Click="BtnNew_Click"/>
                </StackPanel>
            </Grid>

            <!-- Eingabeformular -->
            <Border x:Name="EditorCard" Grid.Row="1"
                    Style="{StaticResource Card}"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="TxtEditorTitle"
                               Text="NEUE AUFGABE"
                               Style="{StaticResource SectionLabel}"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="Was ist zu tun?" Style="{StaticResource LabelText}"/>
                    <TextBox x:Name="TxtTitle" Height="36" FontSize="13"
                             Margin="0,0,0,14"
                             ui:ControlHelper.PlaceholderText="z.B. Arbeitsblatt 3 lösen"
                             KeyDown="TxtTitle_KeyDown"/>

                    <!--
                        Datum und Uhrzeit gehören zusammen: 6 px zwischen ihnen,
                        36 px zum nächsten Feld. Sonst liest man die Uhrzeit als
                        Teil der folgenden Spalte.
                    -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Abgabe" Style="{StaticResource LabelText}"/>
                            <StackPanel Orientation="Horizontal">
                                <DatePicker x:Name="DateDue" Height="36" Width="150"
                                            SelectedDateChanged="DateDue_Changed"/>
                                <ComboBox x:Name="CmbDueTime" Height="36" Width="84"
                                          FontSize="13" IsEditable="True"
                                          Margin="6,0,0,0"
                                          ui:ControlHelper.PlaceholderText="Zeit"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Erinnerung" Style="{StaticResource LabelText}"/>
                            <StackPanel Orientation="Horizontal">
                                <DatePicker x:Name="DateRemind" Height="36" Width="150"/>
                                <ComboBox x:Name="CmbRemindTime" Height="36" Width="84"
                                          FontSize="13" IsEditable="True"
                                          Margin="6,0,0,0"
                                          ui:ControlHelper.PlaceholderText="Zeit"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Liste" Style="{StaticResource LabelText}"/>
                            <ComboBox x:Name="CmbList" Height="36" FontSize="13"
                                      IsEditable="True"
                                      ui:ControlHelper.PlaceholderText="z.B. Deutsch"/>
                        </StackPanel>
                    </Grid>

                    <!-- Schnellwahl für die Erinnerung -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="Erinnern:" Style="{StaticResource LabelText}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="Am Vortag" Tag="1"
                                Style="{StaticResource SecondaryButton}"
                                Padding="10,4" FontSize="12" Margin="0,0,8,0"
                                Click="BtnRemindPreset_Click"/>
                        <Button Content="2 Tage vorher" Tag="2"
                                Style="{StaticResource SecondaryButton}"
                                Padding="10,4" FontSize="12" Margin="0,0,8,0"
                                Click="BtnRemindPreset_Click"/>
                        <Button Content="1 Woche vorher" Tag="7"
                                Style="{StaticResource SecondaryButton}"
                                Padding="10,4" FontSize="12" Margin="0,0,8,0"
                                Click="BtnRemindPreset_Click"/>
                        <Button Content="Keine" Tag="0"
                                Style="{StaticResource SecondaryButton}"
                                Padding="10,4" FontSize="12" Margin="0,0,20,0"
                                Click="BtnRemindPreset_Click"/>
                        <CheckBox x:Name="ChkImportant"
                                  Content="★  Wichtig"
                                  VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Notizen" Style="{StaticResource LabelText}"/>
                    <TextBox x:Name="TxtNotes" FontSize="13"
                             MinHeight="52" MaxHeight="120"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,14"
                             ui:ControlHelper.PlaceholderText="Optional"/>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnSave"
                                Content="Speichern"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,12,0"
                                Click="BtnSave_Click"/>
                        <Button Content="Abbrechen"
                                Style="{StaticResource SecondaryButton}"
                                Click="BtnCancel_Click"/>
                        <TextBlock x:Name="TxtEditorError"
                                   VerticalAlignment="Center" Margin="16,0,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource DangerBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Filter -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,14">
                <RadioButton x:Name="RbOpen" GroupName="TaskFilter"
                             Content="Offen"
                             Margin="0,0,20,0" Tag="Open"
                             Checked="Filter_Changed"/>
                <RadioButton x:Name="RbDone" GroupName="TaskFilter"
                             Content="Erledigt"
                             Margin="0,0,20,0" Tag="Done"
                             Checked="Filter_Changed"/>
                <RadioButton x:Name="RbAll" GroupName="TaskFilter"
                             Content="Alle" Tag="All"
                             Checked="Filter_Changed"/>
                <Button x:Name="BtnClearDone"
                        Content="Erledigte entfernen"
                        Style="{StaticResource SecondaryButton}"
                        Padding="10,4" FontSize="12"
                        Margin="24,0,0,0"
                        Click="BtnClearDone_Click"/>
            </StackPanel>

            <!-- Liste -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                          Padding="0,0,0,24">
                <StackPanel>
                    <Border x:Name="EmptyHint" Style="{StaticResource InfoBox}"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="TxtEmptyTitle"
                                       Text="Noch keine Aufgaben"
                                       FontWeight="SemiBold" FontSize="14"
                                       Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtEmptyBody"
                                       Style="{StaticResource BodyText}"
                                       Text="Lege mit «Neue Aufgabe» deine erste Hausaufgabe an."/>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="TaskList"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
