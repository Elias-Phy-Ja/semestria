<Window x:Class="SchulnetzSync.UI.Onboarding.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:legal="clr-namespace:SchulnetzSync.UI.Legal"
        xmlns:local="clr-namespace:SchulnetzSync.UI"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Semestria einrichten"
        Width="660" Height="640"
        MinWidth="560" MinHeight="540"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Weisses Kontrollkästchen: gut sichtbar in Hell- und Dunkel-Modus -->
        <Style x:Key="VisibleCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground"
                    Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Akzentstreifen oben -->
        <Border Grid.Row="0" Background="{StaticResource AccentBrush}"/>

        <!-- Schritt-Inhalte -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Padding="52,36,52,16">
            <Grid>

                <!-- ══════════════════════════════════
                     SCHRITT 1 — Willkommen
                     ══════════════════════════════════ -->
                <StackPanel x:Name="Step1" HorizontalAlignment="Center" MaxWidth="520">
                    <Image Source="pack://application:,,,/Resources/Semestra_Logo.png"
                           Width="80" Height="80"
                           HorizontalAlignment="Center" Margin="0,0,0,18"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Willkommen bei Semestria"
                               FontSize="26" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock TextAlignment="Center" TextWrapping="Wrap"
                               FontSize="14" Opacity="0.65" Margin="0,0,0,28"
                               Text="Deine Schulprüfungen und Termine immer im Blick — in der App und auf Wunsch auch in Outlook. In wenigen Schritten eingerichtet."/>
                    <Border Style="{StaticResource InfoBox}">
                        <StackPanel>
                            <TextBlock Text="Was Semestria macht:"
                                       FontWeight="SemiBold" FontSize="14"
                                       Margin="0,0,0,12"/>
                            <TextBlock FontSize="13" Margin="0,0,0,6">✅  Liest deinen Schulnetz-Kalender automatisch</TextBlock>
                            <TextBlock FontSize="13" Margin="0,0,0,6">✅  Zeigt Prüfungen &amp; Termine im Kalender der App</TextBlock>
                            <TextBlock FontSize="13" Margin="0,0,0,6">✅  Erkennt Änderungen und aktualisiert Einträge</TextBlock>
                            <TextBlock FontSize="13" Margin="0,0,0,6">➕  Optional: trägt alles in deinen Outlook-Kalender ein</TextBlock>
                            <TextBlock FontSize="13">🔒  Alles lokal — keine Daten auf fremden Servern</TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ══════════════════════════════════
                     SCHRITT 2 — Nutzungsbedingungen
                     ══════════════════════════════════ -->
                <StackPanel x:Name="Step2" Visibility="Collapsed"
                            HorizontalAlignment="Center" MaxWidth="540">
                    <TextBlock Text="📋" FontSize="48"
                               HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="Nutzungsbedingungen und Datenschutz"
                               FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock TextAlignment="Center" TextWrapping="Wrap"
                               FontSize="13" Opacity="0.65" Margin="0,0,0,16"
                               Text="Bitte lies und akzeptiere die folgenden Dokumente, bevor du fortfährst."/>

                    <TabControl Margin="0,0,0,16" BorderThickness="1">
                        <TabItem Header="Nutzungsbedingungen">
                            <ScrollViewer Height="180" Padding="4"
                                          VerticalScrollBarVisibility="Auto">
                                <TextBlock FontFamily="Consolas" FontSize="11"
                                           TextWrapping="Wrap" Opacity="0.8"
                                           LineHeight="17"
                                           Text="{x:Static legal:LegalTexts.Agb}"/>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Datenschutzerklärung">
                            <ScrollViewer Height="180" Padding="4"
                                          VerticalScrollBarVisibility="Auto">
                                <TextBlock FontFamily="Consolas" FontSize="11"
                                           TextWrapping="Wrap" Opacity="0.8"
                                           LineHeight="17"
                                           Text="{x:Static legal:LegalTexts.Datenschutz}"/>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>

                    <CheckBox x:Name="ChkAgb"
                              Style="{StaticResource VisibleCheckBox}"
                              Checked="Legal_CheckChanged"
                              Unchecked="Legal_CheckChanged"
                              Content="Ich habe die Nutzungsbedingungen gelesen und akzeptiere sie."/>
                    <CheckBox x:Name="ChkDatenschutz"
                              Style="{StaticResource VisibleCheckBox}"
                              Checked="Legal_CheckChanged"
                              Unchecked="Legal_CheckChanged"
                              Content="Ich habe die Datenschutzerklärung gelesen und akzeptiere sie."/>
                </StackPanel>

                <!-- ══════════════════════════════════
                     SCHRITT 3 — Feed-URL
                     ══════════════════════════════════ -->
                <StackPanel x:Name="Step3" Visibility="Collapsed"
                            HorizontalAlignment="Center" MaxWidth="520">
                    <TextBlock Text="📡" FontSize="48"
                               HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="Schulnetz Feed-URL"
                               FontSize="24" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock TextAlignment="Center" TextWrapping="Wrap"
                               FontSize="13" Opacity="0.65" Margin="0,0,0,20"
                               Text="Dein persönlicher Kalender-Link aus dem Schulnetz-Portal."/>

                    <!-- Anleitung als Schritte -->
                    <TextBlock Text="So findest du die URL:"
                               FontWeight="SemiBold" FontSize="13"
                               Margin="0,0,0,10"/>
                    <Border Style="{StaticResource InfoBox}" Margin="0,0,0,4">
                        <StackPanel>
                            <TextBlock FontSize="13" Margin="0,0,0,6">1.  Melde dich im Schulnetz-Portal an</TextBlock>
                            <TextBlock FontSize="13" Margin="0,0,0,6">2.  Gehe zu «Stundenplan» oder «Kalender»</TextBlock>
                            <TextBlock FontSize="13" Margin="0,0,0,6">3.  Klicke auf das Download-Symbol (Pfeil nach unten)</TextBlock>
                            <TextBlock FontSize="13" Margin="0,0,0,6">4.  Wähle «Diesen Plan im iCal Format abonnieren»</TextBlock>
                            <TextBlock FontSize="13">5.  Kopiere den Link (beginnt mit webcal:// oder https://)</TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Schulnetz-Mockup: zeigt wo geklickt wird -->
                    <Border CornerRadius="8" Margin="0,12,0,16"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                        <StackPanel>
                            <!-- Portal-Header -->
                            <Border Background="#0066CC" CornerRadius="7,7,0,0"
                                    Padding="14,10">
                                <TextBlock Text="Schülerinnen- und Schülerplan"
                                           Foreground="White" FontWeight="SemiBold"
                                           FontSize="13"/>
                            </Border>
                            <!-- Symbolleiste -->
                            <Border Background="White" Padding="10,6">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Border Background="#0066CC" CornerRadius="4"
                                            Padding="8,4" Margin="4,0,0,0">
                                        <TextBlock Text="⬇  Exportieren"
                                                   Foreground="White" FontSize="12"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <!-- Dropdown-Menü -->
                            <Border Background="White" Padding="6"
                                    BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
                                <StackPanel>
                                    <TextBlock Padding="10,6" FontSize="12"
                                               Foreground="#444">📄  Als PDF exportieren</TextBlock>
                                    <TextBlock Padding="10,6" FontSize="12"
                                               Foreground="#444">📋  Als Liste exportieren</TextBlock>
                                    <!-- Markierte Option -->
                                    <Border Background="#E8F0FE" CornerRadius="4"
                                            Margin="4,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Padding="10,8" FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#0066CC">📅  Diesen Plan im iCal Format abonnieren</TextBlock>
                                            <TextBlock FontSize="11" FontWeight="Bold"
                                                       Foreground="#E53935"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0">← Hier</TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Padding="10,6" FontSize="12"
                                               Foreground="#444">📥  Im iCal-Format herunterladen</TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- URL-Eingabe -->
                    <TextBlock Text="Feed-URL einfügen:"
                               FontWeight="SemiBold" FontSize="13"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtFeedUrl" Height="38" FontSize="13"
                             ui:ControlHelper.PlaceholderText="webcal://schulnetz.example.ch/ical?token=..."
                             TextChanged="TxtFeedUrl_TextChanged"/>
                    <TextBlock x:Name="TxtFeedStatus" FontSize="12"
                               Opacity="0.55" Margin="0,6,0,0"
                               Text="🔒  Die URL wird verschlüsselt gespeichert. Das Token verlässt dein Gerät nie."/>
                </StackPanel>

                <!-- ==================================
                     SCHRITT 4 - Outlook (zweigeteilt: Frage -> Einrichtung)
                     ================================== -->
                <Grid x:Name="Step4" Visibility="Collapsed">

                    <!-- 4a - Die Frage -->
                    <StackPanel x:Name="Step4Ask"
                                HorizontalAlignment="Center" MaxWidth="520">
                        <TextBlock Text="&#x1F517;" FontSize="48"
                                   HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock Text="Outlook jetzt verkn&#252;pfen?"
                                   FontSize="24" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock TextAlignment="Center" TextWrapping="Wrap"
                                   FontSize="13" Opacity="0.75" Margin="0,0,0,20"
                                   Text="{x:Static local:OutlookSetupText.Benefit}"/>

                        <Border Style="{StaticResource InfoBox}" Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="Gut zu wissen"
                                           FontWeight="SemiBold" FontSize="13"
                                           Margin="0,0,0,8"/>
                                <TextBlock FontSize="13" TextWrapping="Wrap"
                                           Margin="0,0,0,8"
                                           Text="{x:Static local:OutlookSetupText.HowItWorks}"/>
                                <TextBlock FontSize="13" TextWrapping="Wrap"
                                           Opacity="0.85"
                                           Text="{x:Static local:OutlookSetupText.SkipConsequence}"/>
                            </StackPanel>
                        </Border>

                        <!-- Nur im Entwickler-Build ohne eigene Registrierung -->
                        <Border x:Name="NoRegistrationHint"
                                Style="{StaticResource WarningBox}"
                                Visibility="Collapsed" Margin="0,0,0,24">
                            <TextBlock FontSize="12" TextWrapping="Wrap"
                                       Text="Diese Version bringt keine App-Registrierung mit. F&#252;r den Outlook-Sync brauchst du eine eigene App-ID &#8212; die Anleitung dazu erscheint im n&#228;chsten Schritt."/>
                        </Border>

                        <Button x:Name="BtnLinkNow"
                                Content="Ja, Outlook jetzt verkn&#252;pfen"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Stretch"
                                Padding="24,13" FontSize="14"
                                Margin="0,0,0,10"
                                Click="BtnLinkNow_Click"/>
                        <Button x:Name="BtnLinkLater"
                                Content="Sp&#228;ter &#8212; erst mal ohne Outlook"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Stretch"
                                Padding="24,13" FontSize="14"
                                Click="BtnLinkLater_Click"/>
                        <TextBlock TextAlignment="Center" TextWrapping="Wrap"
                                   FontSize="12" Opacity="0.55" Margin="0,12,0,0"
                                   Text="Du kannst das jederzeit in den Einstellungen nachholen."/>
                    </StackPanel>

                    <!-- 4b - Die Anmeldung -->
                    <StackPanel x:Name="Step4Setup" Visibility="Collapsed"
                                HorizontalAlignment="Center" MaxWidth="520">
                        <TextBlock Text="&#x1F511;" FontSize="44"
                                   HorizontalAlignment="Center" Margin="0,0,0,14"/>
                        <TextBlock Text="Mit Microsoft anmelden"
                                   FontSize="24" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock TextAlignment="Center" TextWrapping="Wrap"
                                   FontSize="13" Opacity="0.75" Margin="0,0,0,20"
                                   Text="Ein Klick, ein Microsoft-Fenster, fertig. Mehr brauchst du nicht einzurichten."/>

                        <Border Style="{StaticResource InfoBox}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Was Semestria darf"
                                           FontWeight="SemiBold" FontSize="13"
                                           Margin="0,0,0,10"/>
                                <TextBlock FontSize="13" TextWrapping="Wrap" Margin="0,0,0,6">&#x2705;  Pr&#252;fungen und Termine in deinen Kalender eintragen und aktuell halten</TextBlock>
                                <TextBlock FontSize="13" TextWrapping="Wrap" Margin="0,0,0,6">&#x274C;  Keine E-Mails, keine Kontakte, keine Dateien</TextBlock>
                                <TextBlock FontSize="13" TextWrapping="Wrap">&#x1F512;  Du meldest dich direkt bei Microsoft an. Semestria sieht dein Passwort nie.</TextBlock>
                            </StackPanel>
                        </Border>

                        <Button x:Name="BtnSignIn"
                                Content="Mit Microsoft anmelden"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Stretch"
                                Padding="24,13" FontSize="14"
                                Click="BtnSignIn_Click"
                                Margin="0,0,0,12"/>

                        <StackPanel x:Name="SignInSuccess" Visibility="Collapsed"
                                    Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#x2705;" FontSize="18" VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtSignedIn"
                                       Text="Erfolgreich angemeldet!"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource SuccessBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock x:Name="TxtSignInError"
                                   Visibility="Collapsed"
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource DangerBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>

                        <!--
                            Nur sichtbar, wenn diese Version keine eigene
                            App-Registrierung mitbringt (Entwickler-Build).
                            Endnutzer sehen das nie.
                        -->
                        <Expander x:Name="AdvancedIdSection"
                                  Header="Eigene App-ID verwenden"
                                  Visibility="Collapsed"
                                  Margin="0,20,0,0">
                            <StackPanel Margin="0,12,0,0">
                                <Border Style="{StaticResource WarningBox}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Diese Version bringt keine App-Registrierung mit"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   Margin="0,0,0,6"/>
                                        <TextBlock FontSize="12" TextWrapping="Wrap" Opacity="0.90"
                                                   Text="{x:Static local:OutlookSetupText.AccountWarning}"/>
                                    </StackPanel>
                                </Border>

                                <TextBox x:Name="TxtClientId" Height="36" FontSize="13"
                                         ui:ControlHelper.PlaceholderText="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
                                         TextChanged="TxtClientId_TextChanged"/>
                                <TextBlock x:Name="ClientIdHint"
                                           FontSize="12" Opacity="0.60" Margin="0,6,0,14"
                                           TextWrapping="Wrap"
                                           Text="Noch leer &#8212; folge der Anleitung unten."/>

                                <Border CornerRadius="8" Padding="14,12" Margin="0,0,0,12"
                                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                                    <ItemsControl ItemsSource="{x:Static local:OutlookSetupText.Steps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           FontSize="12" TextWrapping="Wrap"
                                                           Opacity="0.88" Margin="0,0,0,6"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <Button x:Name="BtnOpenAzure"
                                        Content="Microsoft-Portal &#246;ffnen"
                                        Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left"
                                        Padding="16,8" FontSize="13"
                                        Click="BtnOpenAzure_Click"/>
                            </StackPanel>
                        </Expander>

                        <Button x:Name="BtnSkipSignIn"
                                Content="Doch sp&#228;ter einrichten"
                                HorizontalAlignment="Center"
                                Margin="0,20,0,0"
                                FontSize="12"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{StaticResource AccentBrush}"
                                Cursor="Hand"
                                Click="BtnSkipSignIn_Click"/>
                    </StackPanel>
                </Grid>

                <!-- ══════════════════════════════════
                     SCHRITT 5 — Fertig
                     ══════════════════════════════════ -->
                <StackPanel x:Name="Step5" Visibility="Collapsed"
                            HorizontalAlignment="Center" MaxWidth="460">
                    <TextBlock Text="🎉" FontSize="72"
                               HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="Alles bereit!"
                               FontSize="28" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock TextAlignment="Center" TextWrapping="Wrap"
                               FontSize="14" Opacity="0.65" Margin="0,0,0,20"
                               Text="SchulnetzSync ist eingerichtet. Du kannst jetzt deine Prüfungen synchronisieren."/>
                    <Border Style="{StaticResource SuccessBox}" Margin="0,0,0,16">
                        <TextBlock x:Name="TxtSetupSummary"
                                   TextWrapping="Wrap" FontSize="13"
                                   LineHeight="22"/>
                    </Border>

                    <!-- Optionen -->
                    <Border CornerRadius="8" Padding="16,14"
                            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="OPTIONEN" FontSize="10" FontWeight="Bold"
                                       Opacity="0.50" Margin="0,0,0,10"/>
                            <CheckBox x:Name="ChkAutoRefresh"
                                      IsChecked="True"
                                      Style="{StaticResource VisibleCheckBox}"
                                      Margin="0,0,0,4"
                                      Content="Feed beim App-Start automatisch aktualisieren"/>
                            <TextBlock FontSize="11" Opacity="0.55"
                                       TextWrapping="Wrap"
                                       Margin="24,0,0,0"
                                       Text="Hält deinen Kalender immer auf dem neuesten Stand. Wenn keine Verbindung besteht, wird der gespeicherte Feed genutzt."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>

        <!-- Fortschritts-Punkte -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,8,0,12">
            <Ellipse x:Name="Dot1" Width="10" Height="10" Margin="5,0"
                     Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
            <Ellipse x:Name="Dot2" Width="8"  Height="8"  Margin="5,0"
                     Fill="{DynamicResource SystemControlForegroundBaseLowBrush}"
                     VerticalAlignment="Center"/>
            <Ellipse x:Name="Dot3" Width="8"  Height="8"  Margin="5,0"
                     Fill="{DynamicResource SystemControlForegroundBaseLowBrush}"
                     VerticalAlignment="Center"/>
            <Ellipse x:Name="Dot4" Width="8"  Height="8"  Margin="5,0"
                     Fill="{DynamicResource SystemControlForegroundBaseLowBrush}"
                     VerticalAlignment="Center"/>
            <Ellipse x:Name="Dot5" Width="8"  Height="8"  Margin="5,0"
                     Fill="{DynamicResource SystemControlForegroundBaseLowBrush}"
                     VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Navigation -->
        <Border Grid.Row="3"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0" Padding="32,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnBack" Grid.Column="0"
                        Content="Zurück"
                        Style="{StaticResource SecondaryButton}"
                        IsEnabled="False"
                        Click="BtnBack_Click"/>
                <Button x:Name="BtnNext" Grid.Column="2"
                        Content="Weiter"
                        Style="{StaticResource PrimaryButton}"
                        Padding="24,10"
                        Click="BtnNext_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
