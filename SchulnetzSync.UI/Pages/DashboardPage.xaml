<Page x:Class="SchulnetzSync.UI.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      Title="Dashboard">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32">

            <!-- Header -->
            <TextBlock Text="Dashboard"
                       Style="{StaticResource TitleText}"
                       Margin="0,0,0,4"/>
            <TextBlock x:Name="TxtHeaderSub"
                       Text="Alles im Blick."
                       Style="{StaticResource BodyText}"
                       Margin="0,0,0,24"/>

            <!-- Hinweis: Setup unvollständig -->
            <Border x:Name="SetupHint" Visibility="Collapsed"
                    Style="{StaticResource WarningBox}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="⚠️  Einrichtung nicht vollständig"
                                   FontWeight="SemiBold" FontSize="14"
                                   Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource BodyText}"
                                   Text="Gehe zu Einstellungen und trage deine Feed-URL ein."/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Einstellungen"
                            Style="{StaticResource SecondaryButton}"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0"
                            Click="BtnGoSettings_Click"/>
                </Grid>
            </Border>

            <!-- STATUS-KARTE -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Status-Zeile -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Ellipse x:Name="StatusDot" Width="10" Height="10"
                                 Fill="{StaticResource WarningBrush}"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtStatusLabel"
                                   Text="Noch kein Sync"
                                   Style="{StaticResource HeadlineText}"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtLastRun"
                               Grid.Row="1" Text="Noch nie synchronisiert"
                               Style="{StaticResource BodyText}" Margin="0,0,0,2"/>

                    <TextBlock x:Name="TxtLastResult"
                               Grid.Row="2" Text=""
                               Style="{StaticResource BodyText}" Margin="0,0,0,16"/>

                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                        <Button x:Name="BtnSync"
                                Content="🔄  Jetzt synchronisieren"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,12,0"
                                Click="BtnSync_Click"/>
                        <Button x:Name="BtnDryRun"
                                Content="👁  Vorschau"
                                Style="{StaticResource SecondaryButton}"
                                Click="BtnDryRun_Click"/>
                    </StackPanel>

                    <ui:ProgressRing x:Name="SyncRing"
                                     Grid.Column="1" Grid.RowSpan="4"
                                     IsActive="False" Width="44" Height="44"
                                     VerticalAlignment="Center" Margin="16,0,0,0"/>
                </Grid>
            </Border>

            <!-- PROTOKOLL -->
            <Border Style="{StaticResource Card}" MinHeight="100">
                <StackPanel>
                    <TextBlock Text="PROTOKOLL" Style="{StaticResource SectionLabel}"
                               Margin="0,0,0,8"/>
                    <ScrollViewer x:Name="LogScroll" MaxHeight="180"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TxtLog"
                                   FontFamily="Consolas" FontSize="12"
                                   TextWrapping="Wrap" Opacity="0.8"
                                   Text="Bereit. Drücke «Jetzt synchronisieren» um zu starten."/>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- STATISTIKEN -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="PRÜFUNGEN" Style="{StaticResource LabelText}"/>
                        <TextBlock x:Name="TxtStatPruefung"
                                   Text="·" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="synchronisiert"
                                   Style="{StaticResource BodyText}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="TERMINE" Style="{StaticResource LabelText}"/>
                        <TextBlock x:Name="TxtStatTermin"
                                   Text="·" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="synchronisiert"
                                   Style="{StaticResource BodyText}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Card}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="STATUS" Style="{StaticResource LabelText}"/>
                        <TextBlock x:Name="TxtStatStatus"
                                   Text="Bereit" FontSize="20" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtStatDetail"
                                   Text="Noch kein Lauf"
                                   Style="{StaticResource BodyText}"/>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
