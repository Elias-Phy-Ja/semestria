<Page x:Class="SchulnetzSync.UI.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      Title="Dashboard">

    <Page.Resources>

        <!-- Half-transparent grey works in both the light and the dark theme -->
        <SolidColorBrush x:Key="HoverOverlay"   Color="#1A808080"/>
        <SolidColorBrush x:Key="PressedOverlay" Color="#2A808080"/>
        <SolidColorBrush x:Key="SubtleFill"     Color="#12808080"/>
        <SolidColorBrush x:Key="SubtleBorder"   Color="#26808080"/>

        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Card without an outer margin; the layout around it handles spacing -->
        <Style x:Key="DashCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Filled primary button -->
        <Style x:Key="AccentAction" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0,16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root">
                            <Border Background="{TemplateBinding Background}" CornerRadius="9"/>
                            <Border x:Name="Overlay" Background="Transparent" CornerRadius="9"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="#1FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="#26000000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Outlined secondary button -->
        <Style x:Key="OutlineAction" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0,16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource SubtleBorder}" BorderThickness="1"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverOverlay}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedOverlay}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text link on the right of a card header, e.g. "Kalender ›" -->
        <Style x:Key="LinkAction" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverOverlay}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A number tile, clickable like a button -->
        <Style x:Key="StatTile" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="14"
                                    BorderBrush="{StaticResource SubtleBorder}" BorderThickness="1"/>
                            <Border x:Name="Overlay" Background="Transparent" CornerRadius="14"/>
                            <ContentPresenter Margin="18,16"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="{StaticResource SubtleFill}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="{StaticResource HoverOverlay}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round tick circle; the code sets its colour through BorderBrush -->
        <Style x:Key="RoundCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="20" Height="20" Background="Transparent">
                            <Ellipse x:Name="Ring" StrokeThickness="2"
                                     Stroke="{TemplateBinding BorderBrush}" Fill="Transparent"/>
                            <TextBlock x:Name="Tick" Text="✓" FontSize="11" FontWeight="Bold"
                                       Visibility="Collapsed"
                                       Foreground="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,1,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,26,20,32">

            <!-- ══════════════ Header ══════════════ -->
            <StackPanel Margin="0,0,12,20">
                <TextBlock x:Name="TxtGreeting" Text="Hallo"
                           FontSize="26" FontWeight="Bold"/>
                <TextBlock x:Name="TxtHeaderSub" Text="Alles im Blick."
                           FontSize="13.5" Opacity="0.65" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Warning shown when there is no feed URL yet -->
            <Border x:Name="SetupHint" Visibility="Collapsed"
                    CornerRadius="14" Padding="18,14" Margin="0,0,12,12"
                    Background="#1FF59E0B" BorderBrush="#66F59E0B" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="20"
                               Foreground="{StaticResource WarningBrush}"
                               VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Einrichtung nicht vollständig"
                                   FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="Trage unter Einstellungen deine Schulnetz Feed-URL ein."
                                   FontSize="13" Opacity="0.8" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="Einstellungen öffnen"
                            Style="{StaticResource OutlineAction}"
                            VerticalAlignment="Center" Margin="16,0,0,0"
                            Click="BtnGoSettings_Click"/>
                </Grid>
            </Border>

            <!-- ══════════════ Status ══════════════ -->
            <Border Style="{StaticResource DashCard}" Margin="0,0,12,12" Padding="20,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status icon: a circle with a glyph, a spinning ring while loading -->
                    <Grid Width="52" Height="52" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Ellipse x:Name="StatusDisc" Fill="#2622C55E"/>
                        <TextBlock x:Name="StatusGlyph" Text="&#xE73E;"
                                   FontFamily="{StaticResource IconFont}" FontSize="22"
                                   Foreground="#22C55E"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <ui:ProgressRing x:Name="SyncRing" IsActive="False"
                                         Width="30" Height="30"
                                         Foreground="{StaticResource AccentBrush}"/>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStatusLabel" Text="Noch kein Sync"
                                   FontSize="17" FontWeight="SemiBold"/>
                        <WrapPanel Margin="0,6,0,0">
                            <Border CornerRadius="10" Padding="9,3" Margin="0,0,6,4"
                                    Background="{StaticResource SubtleFill}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}"
                                               FontSize="11" Opacity="0.7" VerticalAlignment="Center"
                                               Margin="0,1,6,0"/>
                                    <TextBlock x:Name="TxtLastFeed" Text="Feed: noch nie geladen"
                                               FontSize="12" Opacity="0.85"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="OutlookChip" CornerRadius="10" Padding="9,3" Margin="0,0,6,4"
                                    Background="{StaticResource SubtleFill}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}"
                                               FontSize="11" Opacity="0.7" VerticalAlignment="Center"
                                               Margin="0,1,6,0"/>
                                    <TextBlock x:Name="TxtLastRun" Text="Outlook: noch nie synchronisiert"
                                               FontSize="12" Opacity="0.85"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                        <TextBlock x:Name="TxtLastResult" Text="" FontSize="12" Opacity="0.55"
                                   TextWrapping="Wrap" Margin="2,2,0,0"/>
                    </StackPanel>

                    <WrapPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Button x:Name="BtnDryRun" Style="{StaticResource OutlineAction}"
                                Margin="0,0,8,0"
                                ToolTip="Liest den Schulnetz-Feed und aktualisiert den In-App-Kalender. Kein Microsoft-Konto nötig."
                                Click="BtnDryRun_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}"
                                           FontSize="13" VerticalAlignment="Center" Margin="0,1,8,0"/>
                                <TextBlock Text="Feed laden" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnSync" Style="{StaticResource AccentAction}"
                                Click="BtnSync_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}"
                                           FontSize="13" VerticalAlignment="Center" Margin="0,1,8,0"/>
                                <TextBlock Text="Mit Outlook synchronisieren" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- ══════════════ Numbers ══════════════ -->
            <UniformGrid x:Name="StatGrid" Columns="4">
                <Button x:Name="TilePruefung" Style="{StaticResource StatTile}" Click="BtnGoEvents_Click"
                        ToolTip="Kalender öffnen">
                    <StackPanel>
                        <Border x:Name="IconPruefung" Width="34" Height="34" CornerRadius="10"
                                HorizontalAlignment="Left" Background="#26EF4444">
                            <TextBlock x:Name="GlyphPruefung" Text="&#xE7C1;" FontFamily="{StaticResource IconFont}"
                                       FontSize="15" Foreground="#EF4444"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TxtStatPruefung" Text="·" FontSize="30" FontWeight="Bold"
                                   Margin="0,12,0,0"/>
                        <TextBlock Text="Prüfungen" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtStatPruefungSub" Text="im Feed" FontSize="12" Opacity="0.6"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Button>

                <Button x:Name="TileTermin" Style="{StaticResource StatTile}" Click="BtnGoEvents_Click"
                        ToolTip="Kalender öffnen">
                    <StackPanel>
                        <Border x:Name="IconTermin" Width="34" Height="34" CornerRadius="10"
                                HorizontalAlignment="Left" Background="#263B82F6">
                            <TextBlock x:Name="GlyphTermin" Text="&#xE787;" FontFamily="{StaticResource IconFont}"
                                       FontSize="15" Foreground="#3B82F6"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TxtStatTermin" Text="·" FontSize="30" FontWeight="Bold"
                                   Margin="0,12,0,0"/>
                        <TextBlock Text="Termine" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtStatTerminSub" Text="im Feed" FontSize="12" Opacity="0.6"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource StatTile}" Click="BtnGoEvents_Click"
                        ToolTip="Stundenplan öffnen">
                    <StackPanel>
                        <Border Width="34" Height="34" CornerRadius="10"
                                HorizontalAlignment="Left" Background="#2622C55E">
                            <TextBlock Text="&#xE7BE;" FontFamily="{StaticResource IconFont}"
                                       FontSize="15" Foreground="#22C55E"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TxtStatLessons" Text="·" FontSize="30" FontWeight="Bold"
                                   Margin="0,12,0,0"/>
                        <TextBlock x:Name="TxtStatLessonsTitle" Text="Stunden heute" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtStatLessonsSub" Text="" FontSize="12" Opacity="0.6"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource StatTile}" Click="BtnGoTasks_Click"
                        ToolTip="Aufgaben öffnen">
                    <StackPanel>
                        <Border Width="34" Height="34" CornerRadius="10"
                                HorizontalAlignment="Left" Background="#265C6EF7">
                            <TextBlock Text="&#xE9D5;" FontFamily="{StaticResource IconFont}"
                                       FontSize="15" Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TxtStatTasks" Text="0" FontSize="30" FontWeight="Bold"
                                   Margin="0,12,0,0"/>
                        <TextBlock Text="Aufgaben offen" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtStatTasksSub" Text="" FontSize="12" Opacity="0.6"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- ══════════════ Content: two columns, stacked when narrow ══════════════ -->
            <Grid x:Name="ContentGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="MainColumn" Width="*"/>
                    <ColumnDefinition x:Name="SideColumn" Width="360"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- "Als Nächstes" -->
                <Border x:Name="UpcomingCard" Style="{StaticResource DashCard}"
                        Margin="0,0,12,12" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Als Nächstes" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="TxtUpcomingTitle" Text="Die nächsten 7 Tage"
                                           FontSize="12" Opacity="0.6" Margin="0,1,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource LinkAction}"
                                    VerticalAlignment="Top" Click="BtnGoEvents_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Kalender"/>
                                    <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}"
                                               FontSize="10" VerticalAlignment="Center" Margin="6,1,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <StackPanel x:Name="UpcomingEmpty" Visibility="Collapsed" Margin="0,18,0,14">
                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}"
                                       FontSize="26" Opacity="0.35" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtUpcomingEmpty" Text=""
                                       FontSize="13" Opacity="0.65" Margin="0,10,0,0"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel x:Name="UpcomingList"/>
                    </StackPanel>
                </Border>

                <!-- Side column: timetable and tasks -->
                <StackPanel x:Name="SidePanel" Grid.Column="1">

                    <Border Style="{StaticResource DashCard}" Margin="0,0,12,12">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock x:Name="TxtScheduleTitle" Text="Heute im Stundenplan"
                                           Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="TxtScheduleSub" Text="" FontSize="12" Opacity="0.6"
                                           Margin="0,1,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtScheduleEmpty" Visibility="Collapsed"
                                       Text="Keine Stunden gefunden." FontSize="13" Opacity="0.65"
                                       TextWrapping="Wrap" Margin="0,4,0,4"/>
                            <StackPanel x:Name="ScheduleList"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DashCard}" Margin="0,0,12,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Aufgaben" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="TxtTasksSub" Text="" FontSize="12" Opacity="0.6"
                                               Margin="0,1,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource LinkAction}"
                                        VerticalAlignment="Top" Click="BtnGoTasks_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Alle"/>
                                        <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}"
                                                   FontSize="10" VerticalAlignment="Center" Margin="6,1,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock x:Name="TxtTasksEmpty" Visibility="Collapsed"
                                       Text="Nichts offen. Geniess die freie Zeit."
                                       FontSize="13" Opacity="0.65" TextWrapping="Wrap" Margin="0,4,0,4"/>
                            <StackPanel x:Name="TaskList"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ══════════════ Log, collapsible ══════════════ -->
            <Border Style="{StaticResource DashCard}" Margin="0,0,12,0" Padding="0">
                <StackPanel>
                    <Button x:Name="BtnToggleLog" Click="BtnToggleLog_Click" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="14"
                                        Padding="20,12">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubtleFill}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       Opacity="0.6" VerticalAlignment="Center" Margin="0,1,10,0"/>
                            <TextBlock Grid.Column="1" Text="Protokoll" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock x:Name="TxtLogLast" Grid.Column="2" Text=""
                                       FontSize="12" Opacity="0.55" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="LogChevron" Grid.Column="3" Text="&#xE70D;"
                                       FontFamily="{StaticResource IconFont}" FontSize="11" Opacity="0.6"
                                       VerticalAlignment="Center" Margin="12,1,0,0"/>
                        </Grid>
                    </Button>
                    <Border x:Name="LogBody" Visibility="Collapsed" Padding="20,0,20,16">
                        <ScrollViewer x:Name="LogScroll" MaxHeight="180"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtLog"
                                       FontFamily="Consolas" FontSize="12" Opacity="0.85"
                                       TextWrapping="Wrap"
                                       Text="Bereit. «Feed laden» für den In-App-Kalender, «Mit Outlook synchronisieren» für Outlook."/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
